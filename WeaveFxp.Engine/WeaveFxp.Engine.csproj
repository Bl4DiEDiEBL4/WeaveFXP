<Project Sdk="Microsoft.NET.Sdk">

  <!-- Headless engine: FTP/FXP client, models, JSON store, activity log.
       net8.0 (not net8.0-windows) so it runs on Linux too. No UI, no Windows APIs. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>WeaveFxp.Engine</RootNamespace>
    <AssemblyName>WeaveFxp.Engine</AssemblyName>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PublishTrimmed>false</PublishTrimmed>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- System.Text.Json ships in the net8.0 shared framework; no package needed. -->

</Project>
