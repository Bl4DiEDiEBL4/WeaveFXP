@inherits LayoutComponentBase
@inject Microsoft.Extensions.Hosting.IHostApplicationLifetime AppLifetime
@inject WeaveEngine Engine
@inject IJSRuntime Js

<div class="app">
    <aside class="sidebar">
        <div class="brand">
            <img class="brand-logo" src="weavefxp-logo.svg" alt="" />
            <div>
                <div class="brand-name">WEAVE<span>FXP</span></div>
                <div class="brand-meta">v@(Engine.Version) | web fxp</div>
            </div>
        </div>

        <section class="status-card">
            <div class="status-title">ENGINE STATUS</div>
            <div class="status-line"><span class="status-dot on"></span> Running</div>
            <button class="status-action danger" @onclick="StopEngine">
                <span class="nav-glyph">■</span>
                Stop engine
            </button>
        </section>

        <nav class="menus" aria-label="Main menu">
            <div class="menu">
                <div class="menu-title">Menu</div>
                <div class="menu-items">
                    <NavLink class="nav-item" href="" Match="NavLinkMatch.All">
                        <span class="nav-glyph">◈</span>
                        Dashboard
                    </NavLink>
                    <NavLink class="nav-item" href="browser">
                        <span class="nav-glyph">⇄</span>
                        Browse
                    </NavLink>
                    <NavLink class="nav-item" href="favorites">
                        <span class="nav-glyph">★</span>
                        Favorites
                    </NavLink>
                    <NavLink class="nav-item" href="races">
                        <span class="nav-glyph">⚑</span>
                        Races
                    </NavLink>
                </div>
            </div>
            <div class="menu">
                <div class="menu-title">Sites</div>
                <div class="menu-items">
                    <NavLink class="nav-item" href="sites">
                        <span class="nav-glyph">▤</span>
                        Site Manager
                    </NavLink>
                    <NavLink class="nav-item" href="search">
                        <span class="nav-glyph">&#8981;</span>
                        Site Search
                    </NavLink>
                </div>
            </div>
            <div class="menu">
                <div class="menu-title">Tools</div>
                <div class="menu-items">
                    <NavLink class="nav-item" href="stats">
                        <span class="nav-glyph">◔</span>
                        Stats
                    </NavLink>
                    <NavLink class="nav-item" href="history">
                        <span class="nav-glyph">◷</span>
                        History
                    </NavLink>
                    <NavLink class="nav-item" href="logs">
                        <span class="nav-glyph">≡</span>
                        Logs
                    </NavLink>
                    <NavLink class="nav-item" href="api-docs">
                        <span class="nav-glyph">⌘</span>
                        API
                    </NavLink>
                    <NavLink class="nav-item" href="settings">
                        <span class="nav-glyph">⚙</span>
                        Settings
                    </NavLink>
                    <NavLink class="nav-item" href="changelog">
                        <span class="nav-glyph">▣</span>
                        Changelog
                    </NavLink>
                </div>
            </div>
        </nav>
    </aside>

    <section class="shell-content">
        <header class="app-header">
            <div class="header-title">
                <span>WEB FXP CLIENT</span>
                <strong>WeaveFXP</strong>
            </div>
            <div class="header-actions">
                <button type="button" class="top-btn palette-switch" title="Palette: @CurrentPalette.Label. Click for @NextPalette.Label." @onclick="CyclePalette">
                    <span class="palette-swatch" aria-hidden="true"></span>
                    @CurrentPalette.Label
                </button>
                <NavLink class="top-btn" href="browser">
                    <span class="btn-icon">⇄</span>
                    Browse
                </NavLink>
                <NavLink class="top-btn" href="sites">
                    <span class="btn-icon">＋</span>
                    Add site
                </NavLink>
                <NavLink class="top-btn" href="api-docs">
                    <span class="btn-icon">⌘</span>
                    API
                </NavLink>
                <NavLink class="top-btn danger" href="settings">
                    <span class="btn-icon">⚙</span>
                    Settings
                </NavLink>
            </div>
        </header>

        <main class="app-main">
            @Body
        </main>
    </section>
</div>

@code {
    private static readonly Palette[] Palettes =
    {
        new("circuit", "Circuit"),
        new("graphite", "Graphite"),
        new("signal", "Signal"),
        new("voltage", "Voltage"),
        new("daylight", "Daylight"),
    };

    private int _paletteIndex;
    private Palette CurrentPalette => Palettes[_paletteIndex];
    private Palette NextPalette => Palettes[(_paletteIndex + 1) % Palettes.Length];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var selected = await Js.InvokeAsync<string>("weaveFxp.getPalette");
        var index = Array.FindIndex(Palettes, palette => palette.Id.Equals(selected, StringComparison.OrdinalIgnoreCase));
        _paletteIndex = index < 0 ? 0 : index;
        await InvokeAsync(StateHasChanged);
    }

    private async Task CyclePalette()
    {
        _paletteIndex = (_paletteIndex + 1) % Palettes.Length;
        await Js.InvokeVoidAsync("weaveFxp.setPalette", CurrentPalette.Id);
    }

    private void StopEngine() => AppLifetime.StopApplication();

    private sealed record Palette(string Id, string Label);
}
