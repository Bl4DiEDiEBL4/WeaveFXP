@page "/browser"
@implements IDisposable
@using WeaveFxp.Web.Services
@inject WeaveEngine Engine
@inject IJSRuntime Js

@code {
    [SupplyParameterFromQuery(Name = "favorite")]
    public string? FavoriteQuery { get; set; }
}

<h1 class="visually-hidden">Browser</h1>

<div class="browser-page" style="@BrowserStyle" @ref="_browserRoot">
    <nav class="browser-tabs" aria-label="Browser windows">
        @foreach (var tab in _browserTabs)
        {
            <div class="@BrowserTabClass(tab)">
                <button class="browser-tab-main" title="@TabTitle(tab)" @onclick="() => ActivateBrowserTab(tab.Id)">
                    <span class="browser-tab-title">@BrowserTabLabel(tab)</span>
                    <span class="browser-tab-sub">@TabMeta(tab)</span>
                </button>
                @if (_browserTabs.Count > 1)
                {
                    <button class="browser-tab-close" title="Close tab" @onclick="() => CloseBrowserTab(tab.Id)">×</button>
                }
            </div>
        }
        <button class="browser-tab-add" title="New window" @onclick="AddManualBrowserTab">
            <span class="btn-icon">＋</span>
            New Window
        </button>
        <button class="browser-tab-add browser-favorites-toggle" title="Open a favorite window" @onclick="ToggleFavorites">
            <span class="btn-icon">★</span>
            Favorites
        </button>
    </nav>

    @if (_favoritesOpen)
    {
        <div class="context-backdrop" @onclick="CloseFavorites"></div>
        <div class="browser-favorites-menu">
            <div class="context-title">Favorite windows</div>
            @if (_favorites.Count == 0)
            {
                <div class="favorites-empty">No favorites saved.</div>
            }
            else
            {
                @foreach (var favorite in _favorites)
                {
                    <div class="favorite-row">
                        <button class="favorite-open" title="Open @favorite.Name" @onclick="() => OpenFavorite(favorite)">
                            <span class="favorite-star">★</span>
                            <span>@favorite.Name</span>
                            <small>@favorite.Site</small>
                        </button>
                        <button class="favorite-remove" title="Remove @favorite.Name" @onclick="() => RemoveFavorite(favorite)">×</button>
                    </div>
                }
            }
            <div class="context-sep"></div>
            <button class="favorite-save-current" disabled="@(!CanSaveFavorite())" @onclick="OpenSaveFavorite">
                <span class="btn-icon">＋</span>
                Save current window
            </button>
        </div>
    }

    <div class="browsers">
        <PaneView Pane="Active.Left" Sites="_sites" LocalRoots="@LocalRoots()"
                  OnLocal='() => ToggleLocalPane(Active.Left)'
                  OnSiteSelected="s => SelectPaneSite(Active.Left, s)"
                  OnSectionSelected="s => JumpSection(Active.Left, s)"
                  OnPathChanged="p => SetPanePath(Active.Left, p)"
                  OnConnect="() => ListPane(Active.Left)"
                  OnDisconnect="() => DisconnectPane(Active.Left)"
                  OnUp="() => GoUp(Active.Left)"
                  OnGo="() => ListPane(Active.Left)"
                  OnCompare="() => CompareBrowses(Active.Left)"
                  OnDownload="() => Download(Active.Left)"
                  OnOpen="i => OpenEntry(Active.Left, i)"
                  OnSelect="t => ToggleSelect(Active.Left, t.Item1, t.Item2)"
                  OnSort="c => SortPane(Active.Left, c)"
                  OnColumnsChanged="PersistBrowserState"
                  OnContext="t => ShowContext(Active.Left, t.Item1, t.Item2)" />

        <div class="pane-mid">
            <button class="fxp-btn" title="FXP selected: left to right" @onclick="() => QueueFxp(Active.Left, Active.Right)">▶</button>
            <button type="button" class="split-control" title="Drag to resize browses"
                    @onpointerdown="StartSplitDrag" @onpointerdown:preventDefault="true">
                <span class="split-line"></span>
                <span class="split-readout">@Active.SplitPct%</span>
                <span class="split-line"></span>
            </button>
            <button class="fxp-btn" title="FXP selected: right to left" @onclick="() => QueueFxp(Active.Right, Active.Left)">◀</button>
        </div>

        <PaneView Pane="Active.Right" Sites="_sites" LocalRoots="@LocalRoots()"
                  OnLocal='() => ToggleLocalPane(Active.Right)'
                  OnSiteSelected="s => SelectPaneSite(Active.Right, s)"
                  OnSectionSelected="s => JumpSection(Active.Right, s)"
                  OnPathChanged="p => SetPanePath(Active.Right, p)"
                  OnConnect="() => ListPane(Active.Right)"
                  OnDisconnect="() => DisconnectPane(Active.Right)"
                  OnUp="() => GoUp(Active.Right)"
                  OnGo="() => ListPane(Active.Right)"
                  OnCompare="() => CompareBrowses(Active.Right)"
                  OnDownload="() => Download(Active.Right)"
                  OnOpen="i => OpenEntry(Active.Right, i)"
                  OnSelect="t => ToggleSelect(Active.Right, t.Item1, t.Item2)"
                  OnSort="c => SortPane(Active.Right, c)"
                  OnColumnsChanged="PersistBrowserState"
                  OnContext="t => ShowContext(Active.Right, t.Item1, t.Item2)" />
    </div>

    <section class="bottom">
        <div class="bottom-views">
            @if (_tab == "queue")
            {
                <div class="rows">
                    @if (ManualJobs().Count == 0)
                    {
                        <div class="empty-row">No manual jobs yet. Select files and use the arrows, or DL to download locally. Races live on the Races page.</div>
                    }
                    else
                    {
                        @foreach (var job in ManualJobs().Take(60))
                        {
                            <details class="job-row" @key="job.Id">
                                <summary @oncontextmenu="e => ShowJobContext(job, e)" @oncontextmenu:preventDefault="true">
                                    <span class="badge @StateClass(job.State)">@job.State.ToString().ToLowerInvariant()</span>
                                    @if (job.State == JobState.Queued)
                                    {
                                        <span class="queue-move" @onclick:stopPropagation="true" @onclick:preventDefault="true">
                                            <button class="secondary icon-btn" title="Move up" aria-label="Move job up"
                                                    disabled="@(!Engine.CanMoveManualJob(job.Id, -1))" @onclick="() => MoveQueueJob(job.Id, -1)">&#8593;</button>
                                            <button class="secondary icon-btn" title="Move down" aria-label="Move job down"
                                                    disabled="@(!Engine.CanMoveManualJob(job.Id, 1))" @onclick="() => MoveQueueJob(job.Id, 1)">&#8595;</button>
                                        </span>
                                    }
                                    <span class="job-route job-open" title="Double-click to open in browser"
                                          @ondblclick="() => OpenJobTab(job)"
                                          @ondblclick:stopPropagation="true" @ondblclick:preventDefault="true">@DisplayRoute(job)</span>
                                    <span class="job-path job-open"
                                          @ondblclick="() => OpenJobTab(job)"
                                          @ondblclick:stopPropagation="true" @ondblclick:preventDefault="true">@job.Request.SourcePath → @job.Request.DestPath</span>
                                    <span class="job-meta">@job.Type.ToString().ToLowerInvariant() · @job.CreatedAt.ToLocalTime().ToString("HH:mm:ss")</span>
                                    @if (job.Paused)
                                    {
                                        <span class="badge amber">paused</span>
                                    }
                                    @if (job.State == JobState.Running)
                                    {
                                        <span class="job-prog">
                                            <span class="job-bar">
                                                <span class="job-bar-fill @(job.Percent < 0 ? "indet" : "")"
                                                      style="width:@(job.Percent < 0 ? 100 : job.Percent)%"></span>
                                            </span>
                                            <span class="job-prog-text">@ProgressText(job)</span>
                                        </span>
                                    }
                                    else if (job.FilesDone > 0 || job.CumulativeBytes > 0)
                                    {
                                        <span class="job-tally">@job.FilesDone file(s) · @HumanSize(job.CumulativeBytes) @MovedLabel(job)</span>
                                    }
                                </summary>
                                @if (job.State == JobState.Running && job.Slots.Count > 0)
                                {
                                    <div class="job-threads">
                                        @foreach (var slot in job.Slots)
                                        {
                                            <div class="job-thread">
                                                <span class="jt-label">T@(slot.Slot)</span>
                                                <span class="jt-file" title="@slot.File">@slot.File</span>
                                                <span class="job-bar jt-bar">
                                                    <span class="job-bar-fill @(slot.Percent < 0 ? "indet" : "")"
                                                          style="width:@(slot.Percent < 0 ? 100 : slot.Percent)%"></span>
                                                </span>
                                                <span class="jt-stats">
                                                    @(slot.Percent >= 0 ? $"{slot.Percent}%" : "…") ·
                                                    @HumanSize(slot.Done)@(slot.Total > 0 ? $"/{HumanSize(slot.Total)}" : "") ·
                                                    @Speed(slot.Bps)
                                                </span>
                                            </div>
                                        }
                                    </div>
                                }
                                <ul class="events">
                                    @foreach (var ev in job.Events.TakeLast(200))
                                    {
                                        <li class="lvl-@ev.Level">[@ev.Time.ToLocalTime().ToString("HH:mm:ss")] @ev.Level: @ev.Message</li>
                                    }
                                </ul>
                            </details>
                        }
                    }
                </div>
            }
            else
            {
                <div class="logview">
                    @foreach (var e in _logs.Where(l => l.Category == LogCategoryFor(_tab)).TakeLast(400))
                    {
                        <div class="logline @LogLineClass(e)">
                            <span class="log-time">@e.Time.ToLocalTime().ToString("HH:mm:ss")</span>
                            <span class="log-source">@LogSource(e)</span>
                            <span class="log-message">@e.Message</span>
                        </div>
                    }
                </div>
            }
        </div>
        <nav class="bottom-tabs">
            <button class="btab @(_tab == "ftp" ? "active" : "")" @onclick='() => _tab = "ftp"'><span class="tab-icon">⌁</span> FTP Log</button>
            <button class="btab @(_tab == "queue" ? "active" : "")" @onclick='() => _tab = "queue"'><span class="tab-icon">▦</span> Queue @(ActiveJobs() > 0 ? $"({ActiveJobs()})" : "")</button>
            <button class="btab @(_tab == "transfer" ? "active" : "")" @onclick='() => _tab = "transfer"'><span class="tab-icon">⇄</span> Transfer Log</button>
            <button class="btab @(_tab == "system" ? "active" : "")" @onclick='() => _tab = "system"'><span class="tab-icon">◎</span> System Log</button>
            <span class="spacer"></span>
            @if (_tab == "queue")
            {
                <button class="secondary slim" disabled="@(ManualJobs().Count == 0)" @onclick="OpenRemoveAllConfirm">Remove all</button>
            }
            <label class="chk log-autoscroll">
                <input type="checkbox" checked="@_autoScrollLogs" @onchange="SetAutoScroll" />
                Auto-scroll
            </label>
            <button class="secondary slim log-clear" title="Clear all FTP, transfer and system logs" @onclick="OpenClearLogsConfirm">
                <span class="btn-icon">≡</span>
                Clear
            </button>
            <label class="resize-label">Log height <input class="bottom-range" type="range" min="18" max="52"
                    @bind="Active.BottomVh" @bind:event="oninput" @bind:after="PersistBrowserState" /></label>
        </nav>
    </section>
</div>

@if (_saveFavoriteOpen)
{
    <div class="modal-backdrop" @onclick="CloseSaveFavorite"></div>
    <section class="modal favorite-modal" role="dialog" aria-modal="true" aria-labelledby="favorite-title">
        <header>
            <div>
                <h3 id="favorite-title">Save Favorite Window</h3>
                <div class="viewer-meta">The menu shows only the favorite name and site.</div>
            </div>
            <button class="secondary icon-btn" title="Close" @onclick="CloseSaveFavorite">×</button>
        </header>
        <div class="form-grid">
            <label class="wide">Name<input @bind="_favoriteName" placeholder="TV" @onkeydown="FavoriteNameKeyDown" /></label>
        </div>
        <div class="modal-actions">
            <button class="primary" disabled="@(string.IsNullOrWhiteSpace(_favoriteName))" @onclick="SaveFavorite">Save favorite</button>
            <button class="secondary" @onclick="CloseSaveFavorite">Cancel</button>
        </div>
    </section>
}

@if (_contextOpen)
{
    <div class="context-backdrop" @onclick="HideContext"></div>
    <div class="context-menu" style="left:@_contextXpx; top:@_contextYpx">
        <div class="context-title">@ContextTitle()</div>
        @if (_contextKind == ContextKind.Queue)
        {
            <button @onclick="() => MoveQueueJob(_contextJobId, -1)" disabled="@(!Engine.CanMoveManualJob(_contextJobId, -1))">Move up</button>
            <button @onclick="() => MoveQueueJob(_contextJobId, 1)" disabled="@(!Engine.CanMoveManualJob(_contextJobId, 1))">Move down</button>
            <button @onclick="RestartContextJob" disabled="@(!CanRestartContextJob())">Restart</button>
            <button @onclick="RetryContextJob" disabled="@(!CanRetryContextJob())">Retry</button>
            @if (ContextJob?.Paused == true)
            {
                <button @onclick="ResumeContextJob">Resume</button>
            }
            else
            {
                <button @onclick="PauseContextJob" disabled="@(!CanCancelContextJob())">Pause</button>
            }
            <button @onclick="CancelContextJob" disabled="@(!CanCancelContextJob())">Stop</button>
            <button @onclick="RemoveContextJob">Remove</button>
            <button @onclick="OpenRemoveAllConfirm">Remove all</button>
            <button @onclick="OpenCommandShellForQueue">Command Shell</button>
        }
        else
        {
            @* Items adapt to what was right-clicked: a folder, a file, or empty space. *@
            @if (ContextEntry() is { } entry)
            {
                @if (entry.Type == "dir")
                {
                    <button @onclick="OpenContextEntry">Open</button>
                }
                else
                {
                    @if (IsNfoFile(entry.Name))
                    {
                        <button @onclick="() => ViewContextFile(ViewerMode.Text)">NFO Viewer</button>
                    }
                    @if (IsImageFile(entry.Name))
                    {
                        <button @onclick="() => ViewContextFile(ViewerMode.Image)">Image Viewer</button>
                    }
                    <button @onclick="() => ViewContextFile(ViewerMode.Auto)">File Viewer</button>
                }
                <button disabled="@(!CanTransfer(_contextPane))" @onclick="() => TransferFromContext(false)">Transfer to @OtherSideName(_contextPane)</button>
                <button disabled="@(!CanTransfer(_contextPane))" @onclick="() => TransferFromContext(true)">Queue transfer to @OtherSideName(_contextPane)</button>
                <button disabled="@(!CanLocalTransferAction(_contextPane))" @onclick="DownloadContext">@LocalTransferActionLabel(_contextPane)</button>
                <div class="context-sep"></div>
                <button @onclick="CompareContext">Compare folders</button>
                <button class="danger" @onclick="DeleteContext">Delete</button>
                @if (!IsLocalPane(_contextPane))
                {
                    <button class="danger" @onclick="() => OpenCommandShell(DeleteCommand())">Delete command…</button>
                    <button @onclick="() => OpenCommandShell(ChmodCommand())">Chmod 755…</button>
                    @if (entry.Type == "dir")
                    {
                        <button @onclick="() => OpenCommandShell(NukeCommand())">Nuke…</button>
                    }
                }
            }
            else
            {
                @* Empty space: whole-directory / connection actions only. *@
                <button @onclick="CompareContext">Compare folders</button>
                @if (!IsLocalPane(_contextPane))
                {
                    <button class="danger" @onclick="() => OpenCommandShell(RemoveDirCommand())">Delete current dir…</button>
                }
            }
            <div class="context-sep"></div>
            @if (!IsLocalPane(_contextPane))
            {
                <button @onclick="() => OpenCommandShell()">Command Shell</button>
                <button @onclick='() => OpenCommandShell("SITE WHO")'>SITE WHO</button>
                <button @onclick='() => OpenCommandShell("SITE INVITE ")'>Invite…</button>
            }
            <button @onclick="RefreshContextPane">Refresh</button>
        }
    </div>
}

@if (_removeAllConfirmOpen)
{
    <div class="modal-backdrop" @onclick="CloseRemoveAllConfirm"></div>
    <section class="modal confirm-modal" role="dialog" aria-modal="true" aria-labelledby="remove-all-title">
        <header>
            <h3 id="remove-all-title">Remove all manual jobs?</h3>
            <button class="secondary icon-btn" title="Close" @onclick="CloseRemoveAllConfirm">&#215;</button>
        </header>
        <div class="confirm-body">
            <p>Remove @_removeAllIds.Count job(s) from the queue, including completed jobs. Queued and running transfers will be stopped.</p>
            <p>Races and transferred files will not be removed.</p>
        </div>
        <div class="modal-actions">
            <button class="secondary" @onclick="CloseRemoveAllConfirm">Cancel</button>
            <button class="danger" @onclick="RemoveAllQueueJobs">Remove all</button>
        </div>
    </section>
}

@if (_clearLogsConfirmOpen)
{
    <div class="modal-backdrop" @onclick="CloseClearLogsConfirm"></div>
    <section class="modal confirm-modal" role="dialog" aria-modal="true" aria-labelledby="clear-logs-title">
        <header>
            <h3 id="clear-logs-title">Clear all logs?</h3>
            <button class="secondary icon-btn" title="Close" @onclick="CloseClearLogsConfirm">×</button>
        </header>
        <div class="confirm-body">
            <p>This permanently deletes all FTP, Transfer and System log entries from:</p>
            <ul>
                <li>the running application's memory</li>
                <li>the SQLite log history on disk</li>
            </ul>
            <p>These entries will not return after a restart. New log entries will continue to be recorded.</p>
        </div>
        <div class="modal-actions">
            <button class="secondary" @onclick="CloseClearLogsConfirm">Cancel</button>
            <button class="danger" @onclick="ClearBrowserLogs">Clear all logs</button>
        </div>
    </section>
}

@if (_shellOpen)
{
    <div class="modal-backdrop" @onclick="CloseShell"></div>
    <section class="modal shell-modal">
        <header>
            <h3>Command Shell</h3>
            <button class="secondary icon-btn" title="Close" @onclick="CloseShell">×</button>
        </header>
        <div class="form-grid">
            <label>Site<input readonly value="@_shellSite" /></label>
            <label class="wide">Raw FTP command<input @bind="_shellCommand" @bind:event="oninput" placeholder="SITE WHO" /></label>
        </div>
        <div class="modal-actions">
            <button @onclick="ExecuteShell"><span class="btn-icon">▶</span> Execute</button>
            <button class="secondary" @onclick="CloseShell">Cancel</button>
        </div>
        @if (!string.IsNullOrEmpty(_shellResult))
        {
            <pre class="console">@_shellResult</pre>
        }
    </section>
}

@if (_viewerOpen)
{
    <div class="modal-backdrop" @onclick="CloseViewer"></div>
    <section class="modal viewer-modal">
        <header>
            <div>
                <h3>@_viewerTitle</h3>
                <div class="viewer-meta">@_viewerSite · @_viewerPath</div>
            </div>
            <button class="secondary icon-btn" title="Close" @onclick="CloseViewer">×</button>
        </header>
        @if (!string.IsNullOrWhiteSpace(_viewerError))
        {
            <div class="alert error">@_viewerError</div>
        }
        else if (_viewerLoading)
        {
            <div class="pane-overlay busy">Loading file…</div>
        }
        else if (_viewerIsImage)
        {
            <div class="image-viewer">
                <img src="@_viewerImageSrc" alt="@_viewerTitle" />
            </div>
        }
        else
        {
            <pre class="console file-viewer-text">@_viewerText</pre>
        }
    </section>
}

@if (_toast is not null)
{
    <div class="toast show" @key="_toast">@_toast</div>
}

@code {
    private readonly List<BrowserTab> _browserTabs = new() { new BrowserTab("main", "Window 1") };
    private readonly Dictionary<string, string> _raceJobTabs = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _dismissedRaceJobs = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _terminalJobsSeen = new(StringComparer.OrdinalIgnoreCase);
    private DateTime _lastLiveDownloadBrowseRefreshUtc = DateTime.MinValue;
    private ElementReference _browserRoot;
    private DotNetObjectReference<Browser>? _selfRef;
    private List<Site> _sites = new();
    private List<BrowserFavorite> _favorites = new();
    private List<Job> _jobs = new();
    private readonly List<LogEntry> _logs = new();
    private long _logSeq;
    private string _tab = "ftp";
    private bool _autoScrollLogs = true;
    private bool _clearLogsConfirmOpen;
    private bool _favoritesOpen;
    private bool _saveFavoriteOpen;
    private string _favoriteName = "";
    private string? _favoriteToOpen;
    private string? _lastFavoriteQuery;
    private string? _toast;
    private string _activeBrowserTabId = "main";
    private int _browserTabSeq = 1;
    private bool _contextOpen;
    private string _contextXpx = "0px";
    private string _contextYpx = "0px";
    private ContextKind _contextKind;
    private PaneModel? _contextPane;
    private int _contextIndex = -1;
    private string _contextJobId = "";
    private bool _shellOpen;
    private string _shellSite = "";
    private string _shellLogAlias = "";
    private string _shellCommand = "";
    private string _shellResult = "";
    private bool _viewerOpen;
    private bool _viewerLoading;
    private bool _viewerIsImage;
    private string _viewerSite = "";
    private string _viewerPath = "";
    private string _viewerTitle = "File Viewer";
    private string _viewerText = "";
    private string _viewerImageSrc = "";
    private string _viewerError = "";
    private bool _browserStorageReady;
    private bool _restoringBrowserState;
    private const string BrowserStateKey = "weavefxp.browser.v1";
    private static readonly System.Text.Json.JsonSerializerOptions BrowserStateJson = new()
    {
        PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase,
        PropertyNameCaseInsensitive = true,
    };

    private BrowserTab Active => _browserTabs.FirstOrDefault(t => t.Id == _activeBrowserTabId) ?? _browserTabs[0];
    private string BrowserStyle => $"--split-left:{Active.SplitPct}%; --bottom-h:{Active.BottomVh}vh;";

    protected override void OnInitialized()
    {
        _sites = Engine.Sites(true);
        _favorites = Engine.Settings(true).BrowserFavorites;
        _jobs = Engine.Jobs();
        foreach (var job in _jobs.Where(j => j.Terminal))
            _terminalJobsSeen.Add(job.Id);
        Engine.Changed += OnEngineChanged;
        PullLogs();
    }

    protected override void OnParametersSet()
    {
        var requested = FavoriteQuery?.Trim();
        if (string.IsNullOrWhiteSpace(requested) ||
            requested.Equals(_lastFavoriteQuery, StringComparison.OrdinalIgnoreCase)) return;
        _lastFavoriteQuery = requested;
        _favoriteToOpen = requested;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _browserStorageReady = true;
            await RestoreBrowserStateAsync();
        }
        if (_favoriteToOpen is not null)
        {
            var requested = _favoriteToOpen;
            _favoriteToOpen = null;
            _favorites = Engine.Settings(true).BrowserFavorites;
            var favorite = _favorites.FirstOrDefault(f => f.Name.Equals(requested, StringComparison.OrdinalIgnoreCase));
            if (favorite is null) Toast($"Favorite {requested} no longer exists");
            else await OpenFavorite(favorite);
            await InvokeAsync(StateHasChanged);
        }
        if (_autoScrollLogs)
        {
            try
            {
                await Js.InvokeVoidAsync("weaveFxp.scrollLogsToBottom", _browserRoot);
            }
            catch { /* circuit closing */ }
        }
    }

    public void Dispose()
    {
        Engine.Changed -= OnEngineChanged;
        _selfRef?.Dispose();
    }

    private void OnEngineChanged()
    {
        if (Interlocked.Exchange(ref _engineRefreshQueued, 1) != 0) return;
        _ = InvokeAsync(async () =>
        {
            Interlocked.Exchange(ref _engineRefreshQueued, 0);
            var jobs = Engine.Jobs();
            _jobs = jobs;
            var terminal = _jobs.Where(j => j.Terminal && _terminalJobsSeen.Add(j.Id)).ToList();
            var runningDownloads = _jobs
                .Where(j => j.Type == JobType.Download && j.State == JobState.Running)
                .ToList();
            PullLogs();
            var now = DateTime.UtcNow;
            if (runningDownloads.Count > 0 &&
                now - _lastLiveDownloadBrowseRefreshUtc >= TimeSpan.FromSeconds(1))
            {
                _lastLiveDownloadBrowseRefreshUtc = now;
                await RefreshLocalDownloadBrowsesAsync(runningDownloads);
            }
            if (terminal.Count > 0)
                await RefreshBrowsesForJobsAsync(terminal);
            StateHasChanged();
        });
    }

    private int _engineRefreshQueued;

    // ---- favorite windows -----------------------------------------------------------

    private void ToggleFavorites() => _favoritesOpen = !_favoritesOpen;
    private void CloseFavorites() => _favoritesOpen = false;

    private bool TryFavoritePanes(out PaneModel remote, out PaneModel local)
    {
        if (IsLocalPane(Active.Left) && !string.IsNullOrWhiteSpace(Active.Left.Path) &&
            !IsLocalPane(Active.Right) && !string.IsNullOrWhiteSpace(Active.Right.Site))
        {
            remote = Active.Right;
            local = Active.Left;
            return true;
        }
        if (IsLocalPane(Active.Right) && !string.IsNullOrWhiteSpace(Active.Right.Path) &&
            !IsLocalPane(Active.Left) && !string.IsNullOrWhiteSpace(Active.Left.Site))
        {
            remote = Active.Left;
            local = Active.Right;
            return true;
        }
        remote = Active.Left;
        local = Active.Right;
        return false;
    }

    private bool CanSaveFavorite() => TryFavoritePanes(out _, out _);

    private void OpenSaveFavorite()
    {
        if (!TryFavoritePanes(out var remote, out _))
        {
            Toast("Connect one site pane and one local pane first");
            return;
        }
        _favoritesOpen = false;
        _favoriteName = remote.Path.TrimEnd('/').Split('/').LastOrDefault() ?? "";
        if (_favoriteName.Length == 0) _favoriteName = remote.Site;
        _saveFavoriteOpen = true;
    }

    private void CloseSaveFavorite()
    {
        _saveFavoriteOpen = false;
        _favoriteName = "";
    }

    private void FavoriteNameKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") SaveFavorite();
        else if (e.Key == "Escape") CloseSaveFavorite();
    }

    private void SaveFavorite()
    {
        if (!TryFavoritePanes(out var remote, out var local)) return;
        var name = _favoriteName.Trim();
        if (name.Length == 0) return;

        _favorites.RemoveAll(f => f.Name.Equals(name, StringComparison.OrdinalIgnoreCase));
        _favorites.Add(new BrowserFavorite
        {
            Name = name,
            Site = remote.Site,
            RemotePath = NormalizeRemotePath(remote.Path),
            LocalPath = Path.GetFullPath(local.Path),
            LocalSide = ReferenceEquals(local, Active.Left) ? "left" : "right",
        });
        PersistFavorites();
        CloseSaveFavorite();
        Toast($"Saved favorite {name}");
    }

    private void RemoveFavorite(BrowserFavorite favorite)
    {
        _favorites.RemoveAll(f => f.Name.Equals(favorite.Name, StringComparison.OrdinalIgnoreCase));
        PersistFavorites();
    }

    private void PersistFavorites()
    {
        var settings = Engine.Settings(true);
        settings.BrowserFavorites = _favorites.Select(f => new BrowserFavorite
        {
            Name = f.Name,
            Site = f.Site,
            RemotePath = f.RemotePath,
            LocalPath = f.LocalPath,
            LocalSide = AppSettings.NormalizeFavoriteLocalSide(f.LocalSide),
        }).ToList();
        Engine.UpdateSettings(settings);
        _favorites = Engine.Settings(true).BrowserFavorites;
    }

    private async Task OpenFavorite(BrowserFavorite favorite)
    {
        _favoritesOpen = false;
        if (!_sites.Any(s => s.Name.Equals(favorite.Site, StringComparison.OrdinalIgnoreCase)))
        {
            Toast($"Site {favorite.Site} no longer exists");
            return;
        }

        try { Directory.CreateDirectory(favorite.LocalPath); }
        catch (Exception ex) { Toast($"Local folder: {ex.Message}"); return; }

        var side = AppSettings.NormalizeFavoriteLocalSide(favorite.LocalSide);
        var localOnLeft = side switch
        {
            "left" => true,
            "right" => false,
            _ => IsLocalPane(Active.Left) && !IsLocalPane(Active.Right),
        };
        var localPane = localOnLeft ? Active.Left : Active.Right;
        var remotePane = localOnLeft ? Active.Right : Active.Left;

        PrepareFavoritePane(remotePane, favorite.Site, NormalizeRemotePath(favorite.RemotePath));
        PrepareFavoritePane(localPane, "local", Path.GetFullPath(favorite.LocalPath));
        Active.Title = favorite.Name;
        await Task.WhenAll(ListPane(remotePane), ListPane(localPane));
        PersistBrowserState();
    }

    private static void PrepareFavoritePane(PaneModel pane, string site, string path)
    {
        pane.Site = site;
        if (!site.Equals("local", StringComparison.OrdinalIgnoreCase)) pane.LastSite = site;
        pane.Path = path;
        pane.Entries.Clear();
        pane.Selected.Clear();
        ClearCompare(pane);
        pane.Loaded = false;
        pane.Loading = false;
        pane.Error = null;
        pane.Status = "Opening favorite...";
    }

    private void PullLogs()
    {
        var (entries, seq) = Engine.Logs(_logSeq);
        if (entries.Count > 0)
        {
            _logs.AddRange(entries);
            if (_logs.Count > 1500) _logs.RemoveRange(0, _logs.Count - 1500);
            _logSeq = seq;
        }
    }

    // The browser queue is for MANUAL work only (FXP + downloads), like a real FTP
    // client. Races have their own page.
    private List<Job> ManualJobs()
    {
        var positions = Engine.ManualQueuePositions();
        return _jobs.Where(j => j.Type != JobType.Race)
            .OrderBy(j => j.State == JobState.Running ? 0 : j.State == JobState.Queued ? 1 : 2)
            .ThenBy(j => positions.GetValueOrDefault(j.Id, -1))
            .ThenByDescending(j => j.CreatedAt).ToList();
    }
    private int ActiveJobs() => _jobs.Count(j => j.Type != JobType.Race && j.State is JobState.Queued or JobState.Running);
    private static string LogCategoryFor(string tab) => tab switch { "ftp" => "ftp", "transfer" => "transfer", _ => "system" };

    private static string StateClass(JobState s) => s switch
    {
        JobState.Succeeded => "green",
        JobState.Failed => "red",
        JobState.Running => "cyan",
        _ => "amber",
    };

    private static string LineClass(LogEntry e)
    {
        if (e.Level == "error") return "l-err";
        if (e.Level == "warn") return "l-warn";
        if (e.Message.StartsWith("> ")) return "l-sent";
        if (e.Message.StartsWith("< ")) return "l-recv";
        if (e.Message.StartsWith("! ")) return "l-err";
        return "l-info";
    }

    private string LogLineClass(LogEntry e)
    {
        var side = e.Category.Equals("ftp", StringComparison.OrdinalIgnoreCase) ? BrowseSideClass(e.Site) : "";
        return string.IsNullOrEmpty(side) ? LineClass(e) : $"{LineClass(e)} {side}";
    }

    private static string BrowseSideClass(string site)
    {
        if (site.StartsWith("L/", StringComparison.OrdinalIgnoreCase)) return "browse-left-log";
        if (site.StartsWith("R/", StringComparison.OrdinalIgnoreCase)) return "browse-right-log";
        return "";
    }

    private static string LogSource(LogEntry entry)
    {
        if (!string.IsNullOrWhiteSpace(entry.Site))
            return entry.Site;
        return entry.Category;
    }

    // ---- browser tabs ----

    private void AddManualBrowserTab()
    {
        var tab = AddBrowserTab($"Window {_browserTabSeq + 1}", null, true);
        Toast($"Opened {tab.Title}");
        PersistBrowserState();
    }

    private BrowserTab AddBrowserTab(string title, string? jobId, bool activate)
    {
        var id = string.IsNullOrWhiteSpace(jobId) ? $"pane-{++_browserTabSeq}" : $"race-{jobId}";
        if (_browserTabs.Any(t => t.Id == id))
        {
            var existing = _browserTabs.First(t => t.Id == id);
            if (activate) _activeBrowserTabId = existing.Id;
            return existing;
        }

        var tab = new BrowserTab(id, title) { JobId = jobId };
        _browserTabs.Add(tab);
        if (activate) _activeBrowserTabId = tab.Id;
        return tab;
    }

    private void ActivateBrowserTab(string id)
    {
        if (_browserTabs.Any(t => t.Id == id))
        {
            _activeBrowserTabId = id;
            HideContext();
            PersistBrowserState();
        }
    }

    private void CloseBrowserTab(string id)
    {
        if (_browserTabs.Count <= 1) return;
        var index = _browserTabs.FindIndex(t => t.Id == id);
        if (index < 0) return;
        var closing = _browserTabs[index];
        if (!string.IsNullOrWhiteSpace(closing.JobId))
        {
            _raceJobTabs.Remove(closing.JobId);
            // Remember it so SyncRaceTabs never re-opens a tab the user closed.
            _dismissedRaceJobs.Add(closing.JobId!);
        }
        _browserTabs.RemoveAt(index);
        if (_activeBrowserTabId == id)
            _activeBrowserTabId = _browserTabs[Math.Clamp(index - 1, 0, _browserTabs.Count - 1)].Id;
        HideContext();
        PersistBrowserState();
    }

    // Open a browser tab for a job on demand — only when the user clicks the queue row.
    // Nothing auto-opens from the API anymore.
    private void OpenJobTab(Job job)
    {
        _dismissedRaceJobs.Remove(job.Id);
        if (_raceJobTabs.TryGetValue(job.Id, out var existingId) && _browserTabs.Any(t => t.Id == existingId))
        {
            _activeBrowserTabId = existingId;
        }
        else
        {
            var tab = AddBrowserTab(RaceTabTitle(job), job.Id, true);
            SeedRaceTab(tab, job);
            _raceJobTabs[job.Id] = tab.Id;
        }
        PersistBrowserState();
        StateHasChanged();
    }

    private static string RaceTabTitle(Job job)
    {
        var name = RemoteLeaf(job.Request.SourcePath);
        if (string.IsNullOrWhiteSpace(name)) name = RemoteLeaf(job.Request.DestPath);
        if (string.IsNullOrWhiteSpace(name)) name = job.Request.Label;
        if (string.IsNullOrWhiteSpace(name)) name = "Race";
        return name.Length > 28 ? name[..28] + "..." : name;
    }

    private static void SeedRaceTab(BrowserTab tab, Job job)
    {
        tab.Left.Site = job.Request.FromSite;
        tab.Left.Path = ParentPath(job.Request.SourcePath);
        tab.Left.Status = job.Request.SourcePath;
        tab.Right.Site = job.Request.MeshSites.Count > 1
            ? job.Request.MeshSites.FirstOrDefault(s => !s.Equals(job.Request.FromSite, StringComparison.OrdinalIgnoreCase)) ?? ""
            : job.Request.ToSite;
        tab.Right.Path = ParentPath(job.Request.DestPath);
        tab.Right.Status = job.Request.DestPath;
    }

    private string BrowserTabClass(BrowserTab tab)
    {
        var job = JobForTab(tab);
        var state = job is null ? "manual" : job.State.ToString().ToLowerInvariant();
        var active = tab.Id == Active.Id ? " active" : "";
        return $"browser-tab-item state-{state}{active}";
    }

    private string TabTitle(BrowserTab tab)
    {
        var job = JobForTab(tab);
        return job is null ? BrowserTabLabel(tab) : $"{job.Type}: {DisplayRoute(job)}";
    }

    private string BrowserTabLabel(BrowserTab tab)
    {
        if (JobForTab(tab) is not null) return tab.Title;

        var connectedSites = new[] { tab.Left, tab.Right }
            .Where(p => p.Loaded && p.Error is null && !string.IsNullOrWhiteSpace(p.Site))
            .Select(p => IsLocalPane(p) ? "Local" : p.Site)
            .ToList();
        return connectedSites.Count == 0 ? tab.Title : string.Join(" - ", connectedSites);
    }

    private string TabMeta(BrowserTab tab)
    {
        var job = JobForTab(tab);
        if (job is not null) return $"{job.State} · {DisplayRoute(job)}";
        var panes = new[] { tab.Left, tab.Right }
            .Where(p => p.Loaded && p.Error is null)
            .ToList();
        var serverCount = panes.Count(p => !IsLocalPane(p));
        var hasLocal = panes.Any(IsLocalPane);
        if (serverCount == 0 && !hasLocal) return "empty window";
        if (serverCount > 0 && hasLocal) return $"{serverCount} server + local";
        if (serverCount > 0) return $"{serverCount} server pane(s)";
        return "local pane(s)";
    }

    private Job? JobForTab(BrowserTab tab) =>
        string.IsNullOrWhiteSpace(tab.JobId) ? null : _jobs.FirstOrDefault(j => j.Id == tab.JobId);

    private static string DisplayRoute(Job job) => job.Request.MeshSites.Count > 1
        ? "Mesh"
        : $"{job.Request.FromSite} → {job.Request.ToSite}";

    private async Task StartSplitDrag(PointerEventArgs e)
    {
        _selfRef ??= DotNetObjectReference.Create(this);
        await Js.InvokeVoidAsync("weaveFxp.startSplitDrag", _browserRoot, _selfRef, Active.Id, e.ClientX);
