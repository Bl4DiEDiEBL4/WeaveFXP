    private void Download(PaneModel pane)
    {
        if (string.IsNullOrEmpty(pane.Site)) { Toast("Pick a site first"); return; }
        if (IsLocalPane(pane))
        {
            QueueFxp(pane, OtherPane(pane));
            return;
        }
        var picks = pane.Selected.Select(i => pane.Entries[i]).ToList();
        if (picks.Count == 0) { Toast("Select files or directories first"); return; }
        var other = OtherPane(pane);
        var localDest = IsLocalPane(other) && other.Loaded ? other.Path : "";
        var queued = 0;
        foreach (var entry in picks)
        {
            var src = EntryPath(pane, entry);
            var dest = string.IsNullOrEmpty(localDest) ? "" : Path.Combine(localDest, entry.Name);
            try { Engine.StartDownload(new DownloadRequest { Site = pane.Site, SourcePath = src, DestPath = dest }); queued++; }
            catch (Exception ex) { Toast($"{entry.Name}: {ex.Message}"); }
        }
        if (queued > 0)
        {
            Toast(string.IsNullOrEmpty(localDest)
                ? $"Queued {queued} download(s) from {pane.Site}"
                : $"Queued {queued} download(s) to {localDest}");
            _tab = "queue";
        }
    }

    private async Task Sfv(PaneModel pane)
    {
        if (string.IsNullOrEmpty(pane.Site)) { Toast("Pick a site first"); return; }
        pane.Status = "Checking release…";
        await InvokeAsync(StateHasChanged);
        try
        {
            var check = await Engine.CheckReleaseAsync(pane.Site, pane.Path);
            Toast($"{(string.IsNullOrEmpty(check.Name) ? check.Path : check.Name)}: {check.State.ToString().ToLowerInvariant()}");
            _tab = "system";
        }
        catch (Exception ex) { Toast(ex.Message); }
        UpdatePaneStatus(pane);
    }

    // ---- helpers ----

    private static string HumanSize(long bytes)
    {
        if (bytes <= 0) return "0 B";
        string[] units = { "B", "KB", "MB", "GB", "TB" };
        double v = bytes;
        var u = 0;
        while (v >= 1024 && u < units.Length - 1) { v /= 1024; u++; }
        return u == 0 ? $"{bytes} B" : $"{v.ToString(v >= 100 ? "0" : "0.0")} {units[u]}";
    }

    private static string Speed(double bps)
    {
        if (bps <= 0) return "";
        string[] units = { "B/s", "KB/s", "MB/s", "GB/s" };
        var v = bps;
        var u = 0;
        while (v >= 1024 && u < units.Length - 1) { v /= 1024; u++; }
        return $"{v.ToString(v >= 100 ? "0" : "0.0")} {units[u]}";
    }

    private static bool IsNfoFile(string name)
    {
        var ext = Path.GetExtension(name);
        return ext.Equals(".nfo", StringComparison.OrdinalIgnoreCase) ||
               ext.Equals(".diz", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsImageFile(string name)
    {
        var ext = Path.GetExtension(name);
        return ext.Equals(".jpg", StringComparison.OrdinalIgnoreCase) ||
               ext.Equals(".jpeg", StringComparison.OrdinalIgnoreCase) ||
               ext.Equals(".png", StringComparison.OrdinalIgnoreCase) ||
               ext.Equals(".gif", StringComparison.OrdinalIgnoreCase) ||
               ext.Equals(".bmp", StringComparison.OrdinalIgnoreCase) ||
               ext.Equals(".webp", StringComparison.OrdinalIgnoreCase);
    }

    private static string ViewerLabel(string name) => IsNfoFile(name) ? "NFO Viewer" : "File Viewer";

    private static string ImageMime(string name)
    {
        var ext = Path.GetExtension(name);
        if (ext.Equals(".jpg", StringComparison.OrdinalIgnoreCase) || ext.Equals(".jpeg", StringComparison.OrdinalIgnoreCase)) return "image/jpeg";
        if (ext.Equals(".png", StringComparison.OrdinalIgnoreCase)) return "image/png";
        if (ext.Equals(".gif", StringComparison.OrdinalIgnoreCase)) return "image/gif";
        if (ext.Equals(".bmp", StringComparison.OrdinalIgnoreCase)) return "image/bmp";
        if (ext.Equals(".webp", StringComparison.OrdinalIgnoreCase)) return "image/webp";
        return "application/octet-stream";
    }

    private static string DecodeViewerText(byte[] bytes, string name)
    {
        if (IsNfoFile(name) || Path.GetExtension(name).Equals(".sfv", StringComparison.OrdinalIgnoreCase))
            return Cp437Encoding.Instance.GetString(bytes);

        try
        {
            var utf8 = new System.Text.UTF8Encoding(false, true);
            return utf8.GetString(bytes);
        }
        catch
        {
            return Cp437Encoding.Instance.GetString(bytes);
        }
    }

    private static string ProgressText(Job job)
    {
        // Downloads move real bytes through us → show size + speed. FXP is
        // server-to-server (no bytes flow through the app) → show a file count.
        if (job.Type is JobType.Download or JobType.Upload)
        {
            var pct = job.Percent >= 0 ? $"{job.Percent}% · " : "";
            var size = job.BytesTotal > 0 ? $"{HumanSize(job.BytesDone)}/{HumanSize(job.BytesTotal)}" : HumanSize(job.CumulativeBytes);
            var spd = Speed(job.SpeedBps);
            var files = job.FilesTotal > 1 ? $" · {job.FilesDone}/{job.FilesTotal} files" : "";
            var file = string.IsNullOrEmpty(job.CurrentFile) ? "" : $" · {job.CurrentFile}";
            return $"{pct}{size}{(spd.Length > 0 ? " · " + spd : "")}{files}{file}";
        }
        // FXP / race: file-count bar plus real moved bytes and average throughput
        // (computed from completed-file sizes over elapsed time).
        var count = job.FilesTotal > 0 ? $"{job.FilesDone}/{job.FilesTotal} files" : $"{job.FilesDone} files";
        var bytes = job.CumulativeBytes > 0 ? $" · {HumanSize(job.CumulativeBytes)}" : "";
        var speed = job.SpeedBps > 0 ? $" · {Speed(job.SpeedBps)}" : "";
        var cur = string.IsNullOrEmpty(job.CurrentFile) ? "" : $" · {job.CurrentFile}";
        return $"{count}{bytes}{speed}{cur}";
    }

    private static string MovedLabel(Job job) => job.Type == JobType.Race ? "raced" : "transferred";

    private static string PJoin(string basePath, string name)
    {
        basePath = (basePath ?? "/").Trim();
        if (basePath.Length == 0 || basePath == "/") return "/" + name.TrimStart('/');
        return basePath.TrimEnd('/') + "/" + name.TrimStart('/');
    }

    private static string ParentPath(string path)
    {
        path = (path ?? "/").TrimEnd('/');
        if (path.Length == 0) return "/";
        var idx = path.LastIndexOf('/');
        return idx <= 0 ? "/" : path[..idx];
    }

    private static string RemoteLeaf(string path)
    {
        path = (path ?? "").Trim().TrimEnd('/', '\\');
        if (path.Length == 0) return "";
        var slash = path.LastIndexOf('/');
        var backslash = path.LastIndexOf('\\');
        var idx = Math.Max(slash, backslash);
        return idx >= 0 ? path[(idx + 1)..] : path;
    }

    private static string BrowseLogName(PaneModel pane)
    {
        if (string.IsNullOrWhiteSpace(pane.Site)) return "";
        return pane.Side.Equals("right", StringComparison.OrdinalIgnoreCase)
            ? $"R/{pane.Site}"
            : $"L/{pane.Site}";
    }

