    private void CompareBrowses(PaneModel pane)
    {
        var other = OtherPane(pane);
        if (!pane.Loaded || !other.Loaded)
        {
            Toast("Load both browses first");
            return;
        }

        ClearCompare(pane);
        ClearCompare(other);

        var left = pane.Entries
            .Where(e => e.Name is not "." and not "..")
            .GroupBy(e => e.Name, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);
        var right = other.Entries
            .Where(e => e.Name is not "." and not "..")
            .GroupBy(e => e.Name, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);

        var same = 0;
        var diff = 0;
        var missingLeft = 0;
        var missingRight = 0;

        foreach (var (name, entry) in left)
        {
            if (!right.TryGetValue(name, out var otherEntry))
            {
                pane.CompareMissing.Add(name);
                missingRight++;
                continue;
            }
            if (EntriesEqual(entry, otherEntry))
            {
                pane.CompareSame.Add(name);
                other.CompareSame.Add(name);
                same++;
            }
            else
            {
                pane.CompareDifferent.Add(name);
                other.CompareDifferent.Add(name);
                diff++;
            }
        }

        foreach (var name in right.Keys)
        {
            if (left.ContainsKey(name)) continue;
            other.CompareMissing.Add(name);
            missingLeft++;
        }

        pane.Status = $"{pane.Status} — compare: {same} same, {diff} different, {missingRight} missing on other";
        other.Status = $"{other.Status} — compare: {same} same, {diff} different, {missingLeft} missing on other";
        Toast($"Compare: {same} same, {diff} different, {missingLeft + missingRight} missing");
    }

    private static bool EntriesEqual(RemoteEntry a, RemoteEntry b)
    {
        if (!a.Type.Equals(b.Type, StringComparison.OrdinalIgnoreCase)) return false;
        if (a.Type == "dir") return true;
        return a.Size == b.Size;
    }

