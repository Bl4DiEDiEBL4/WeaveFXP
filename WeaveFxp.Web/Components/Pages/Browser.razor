    private async Task ViewContextFile(ViewerMode mode)
    {
        var pane = _contextPane;
        var entry = ContextEntry();
        HideContext();

        if (pane is null || entry is null) return;
        if (string.IsNullOrWhiteSpace(pane.Site)) { Toast("Browse has no connected site"); return; }
        if (!entry.Type.Equals("file", StringComparison.OrdinalIgnoreCase)) { Toast("Pick a file first"); return; }

        var path = EntryPath(pane, entry);
        var image = mode == ViewerMode.Image || (mode == ViewerMode.Auto && IsImageFile(entry.Name));

        _viewerOpen = true;
        _viewerLoading = true;
        _viewerIsImage = image;
        _viewerSite = pane.Site;
        _viewerPath = path;
        _viewerTitle = image ? $"Image Viewer - {entry.Name}" : $"{ViewerLabel(entry.Name)} - {entry.Name}";
        _viewerText = "";
        _viewerImageSrc = "";
        _viewerError = "";
        await InvokeAsync(StateHasChanged);

        try
        {
            var bytes = IsLocalPane(pane)
                ? await File.ReadAllBytesAsync(path)
                : await Engine.RetrieveRemoteFileAsync(pane.Site, path);
            if (image)
            {
                _viewerImageSrc = $"data:{ImageMime(entry.Name)};base64,{Convert.ToBase64String(bytes)}";
            }
            else
            {
                _viewerText = DecodeViewerText(bytes, entry.Name);
            }
        }
        catch (Exception ex)
        {
            _viewerError = ex.Message;
        }
        finally
        {
            _viewerLoading = false;
        }
    }

