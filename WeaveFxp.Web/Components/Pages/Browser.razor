    // ---- browser state ---------------------------------------------------------------

    private async Task RestoreBrowserStateAsync()
    {
        try
        {
            var json = await Js.InvokeAsync<string?>("localStorage.getItem", BrowserStateKey);
            if (string.IsNullOrWhiteSpace(json)) return;
            var state = System.Text.Json.JsonSerializer.Deserialize<BrowserStateSnapshot>(json, BrowserStateJson);
            if (state is null || state.Tabs.Count == 0) return;

            _restoringBrowserState = true;
            _autoScrollLogs = state.AutoScrollLogs ?? true;
            _browserTabs.Clear();
            _raceJobTabs.Clear();
            _dismissedRaceJobs.Clear();
            foreach (var jobId in state.DismissedRaceJobs)
                if (!string.IsNullOrWhiteSpace(jobId)) _dismissedRaceJobs.Add(jobId);
            foreach (var saved in state.Tabs.Take(12))
            {
                var id = string.IsNullOrWhiteSpace(saved.Id) ? $"browse-{_browserTabs.Count + 1}" : saved.Id;
                var title = string.IsNullOrWhiteSpace(saved.JobId)
                    ? ManualWindowTitle(saved.Title, _browserTabs.Count + 1)
                    : string.IsNullOrWhiteSpace(saved.Title) ? "Race" : saved.Title;
                var tab = new BrowserTab(id, title)
                {
                    JobId = saved.JobId,
                    SplitPct = Math.Clamp(saved.SplitPct == 0 ? 50 : saved.SplitPct, 28, 72),
                    BottomVh = Math.Clamp(saved.BottomVh == 0 ? 30 : saved.BottomVh, 18, 52),
                };
                RestorePane(tab.Left, saved.Left);
                RestorePane(tab.Right, saved.Right);
                _browserTabs.Add(tab);
                if (!string.IsNullOrWhiteSpace(tab.JobId))
                    _raceJobTabs[tab.JobId] = tab.Id;
            }

            if (_browserTabs.Count == 0)
                _browserTabs.Add(new BrowserTab("main", "Window 1"));

            _activeBrowserTabId = _browserTabs.Any(t => t.Id == state.ActiveTabId)
                ? state.ActiveTabId
                : _browserTabs[0].Id;
            _browserTabSeq = Math.Max(_browserTabSeq, _browserTabs.Count);
            await RestoreLoadedBrowsesAsync();
        }
        catch (Exception ex)
        {
            Toast("Browser state restore failed: " + ex.Message);
        }
        finally
        {
            _restoringBrowserState = false;
        }
        await InvokeAsync(StateHasChanged);
    }

    private static string ManualWindowTitle(string? title, int index)
    {
        if (string.IsNullOrWhiteSpace(title) ||
            title.Equals("Main", StringComparison.OrdinalIgnoreCase) ||
            title.Equals("Browse", StringComparison.OrdinalIgnoreCase) ||
            title.StartsWith("Browse ", StringComparison.OrdinalIgnoreCase))
            return $"Window {index}";
        return title;
    }

    private async Task RestoreLoadedBrowsesAsync()
    {
        foreach (var pane in AllPanes().Where(p => !string.IsNullOrWhiteSpace(p.Site)))
            await ListPane(pane, true);
    }

    private static void RestorePane(PaneModel pane, PaneSnapshot? snapshot)
    {
        if (snapshot is null) return;
        pane.Site = snapshot.Site ?? "";
        pane.LastSite = snapshot.LastSite ?? "";
        pane.Path = string.IsNullOrWhiteSpace(snapshot.Path) ? "/" : snapshot.Path.Trim();
        pane.SortColumn = string.IsNullOrWhiteSpace(snapshot.SortColumn) ? "name" : snapshot.SortColumn.Trim();
        pane.SortDesc = snapshot.SortDesc;
        pane.ColumnOrder = NormalizePaneColumns(snapshot.ColumnOrder);
        pane.Status = string.IsNullOrWhiteSpace(pane.Site) ? "Idle" : "Restoring...";
        pane.Loaded = false;
        pane.Loading = false;
        pane.Error = null;
        pane.Selected.Clear();
    }

    private void PersistBrowserState()
    {
        if (!_browserStorageReady || _restoringBrowserState) return;
        _ = InvokeAsync(SaveBrowserStateAsync);
    }

    private async Task SaveBrowserStateAsync()
    {
        if (!_browserStorageReady || _restoringBrowserState) return;
        var state = new BrowserStateSnapshot
        {
            ActiveTabId = _activeBrowserTabId,
            AutoScrollLogs = _autoScrollLogs,
            DismissedRaceJobs = _dismissedRaceJobs.ToList(),
            Tabs = _browserTabs.Select(t => new BrowserTabSnapshot
            {
                Id = t.Id,
                Title = t.Title,
                JobId = t.JobId,
                SplitPct = t.SplitPct,
                BottomVh = t.BottomVh,
                Left = SnapshotPane(t.Left),
                Right = SnapshotPane(t.Right),
            }).ToList(),
        };
        var json = System.Text.Json.JsonSerializer.Serialize(state, BrowserStateJson);
        await Js.InvokeVoidAsync("localStorage.setItem", BrowserStateKey, json);
    }

    private void SetAutoScroll(ChangeEventArgs e)
    {
        _autoScrollLogs = e.Value is bool enabled && enabled;
        PersistBrowserState();
    }

    private void ClearBrowserLogs()
    {
        _clearLogsConfirmOpen = false;
        var count = Engine.ClearLogs();
        _logs.Clear();
        _logSeq = 0;
        PullLogs();
        Toast($"Cleared {count} log row(s)");
    }

    private void OpenClearLogsConfirm() => _clearLogsConfirmOpen = true;
    private void CloseClearLogsConfirm() => _clearLogsConfirmOpen = false;

    private static PaneSnapshot SnapshotPane(PaneModel pane) => new()
    {
        Site = pane.Site,
        LastSite = pane.LastSite,
        Path = pane.Path,
        SortColumn = pane.SortColumn,
        SortDesc = pane.SortDesc,
        ColumnOrder = NormalizePaneColumns(pane.ColumnOrder),
    };

    private static List<string> NormalizePaneColumns(IEnumerable<string>? columns)
    {
        var defaults = new[] { "name", "owner", "group", "size", "modified" };
        var result = (columns ?? Array.Empty<string>())
            .Where(c => defaults.Contains(c, StringComparer.OrdinalIgnoreCase))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        foreach (var column in defaults)
            if (!result.Contains(column, StringComparer.OrdinalIgnoreCase))
                result.Add(column);
        return result;
    }

    private IEnumerable<PaneModel> AllPanes()
    {
        foreach (var tab in _browserTabs)
        {
            yield return tab.Left;
            yield return tab.Right;
        }
    }

    private async Task RefreshBrowsesForJobsAsync(IReadOnlyList<Job> jobs)
    {
        var refresh = new HashSet<PaneModel>();
        foreach (var job in jobs)
        {
            foreach (var pane in AllPanes())
            {
                if (ShouldRefreshPaneForJob(pane, job))
                    refresh.Add(pane);
            }
        }

        foreach (var pane in refresh)
            await ListPane(pane, true);

        if (refresh.Count > 0)
            Toast($"Refreshed {refresh.Count} browse(s) after transfer");
    }

    private async Task RefreshLocalDownloadBrowsesAsync(IReadOnlyList<Job> jobs)
    {
        var refresh = new HashSet<PaneModel>();
        foreach (var job in jobs)
        {
            foreach (var pane in AllPanes())
            {
                if (IsLocalPane(pane) && ShouldRefreshPaneForJob(pane, job))
                    refresh.Add(pane);
            }
        }

        foreach (var pane in refresh)
        {
            if (pane.Loading) continue;
            pane.Loading = true;
            try
            {
                var selectedPaths = pane.Selected
                    .Where(index => index >= 0 && index < pane.Entries.Count)
                    .Select(index => pane.Entries[index].Path)
                    .ToHashSet(StringComparer.OrdinalIgnoreCase);
                var entries = await Task.Run(() => ListLocal(pane.Path));
                pane.Entries = entries;
                ApplySort(pane);
                pane.Selected = pane.Entries
                    .Select((entry, index) => (entry, index))
                    .Where(item => selectedPaths.Contains(item.entry.Path))
                    .Select(item => item.index)
                    .ToHashSet();
                pane.Loaded = true;
                pane.Error = null;
                UpdatePaneStatus(pane);
            }
            catch
            {
                // A transient local listing failure should not interrupt the download.
            }
            finally
            {
                pane.Loading = false;
            }
        }
    }

    private static bool ShouldRefreshPaneForJob(PaneModel pane, Job job)
    {
        if (string.IsNullOrWhiteSpace(pane.Site) || string.IsNullOrWhiteSpace(job.Request.ToSite)) return false;
        if (IsLocalPane(pane) && job.Type == JobType.Download)
            return LocalPathTouchesBrowse(pane.Path, job.Request.DestPath);
        if (!IsLocalPane(pane) && job.Type == JobType.Upload && pane.Site.Equals(job.Request.ToSite, StringComparison.OrdinalIgnoreCase))
            return PathTouchesBrowse(pane.Path, job.Request.DestPath);
        if (!pane.Site.Equals(job.Request.ToSite, StringComparison.OrdinalIgnoreCase)) return false;
        return PathTouchesBrowse(pane.Path, job.Request.DestPath);
    }

    private static bool LocalPathTouchesBrowse(string browsePath, string changedPath)
    {
        if (string.IsNullOrWhiteSpace(browsePath) || string.IsNullOrWhiteSpace(changedPath)) return false;
        var browse = Path.GetFullPath(browsePath);
        var changed = Path.GetFullPath(changedPath);
        var parent = Path.GetDirectoryName(changed) ?? changed;
        return browse.Equals(parent, StringComparison.OrdinalIgnoreCase) ||
               browse.Equals(changed, StringComparison.OrdinalIgnoreCase) ||
               parent.StartsWith(browse.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar) + Path.DirectorySeparatorChar, StringComparison.OrdinalIgnoreCase);
    }

    private static bool PathTouchesBrowse(string browsePath, string changedPath)
    {
        var browse = NormalizeRemotePath(browsePath);
        var changed = NormalizeRemotePath(changedPath);
        if (changed.Length == 0) return false;
        var parent = ParentPath(changed);
        return browse.Equals(parent, StringComparison.OrdinalIgnoreCase) ||
            browse.Equals(changed, StringComparison.OrdinalIgnoreCase) ||
            browse.StartsWith(changed.TrimEnd('/') + "/", StringComparison.OrdinalIgnoreCase);
    }

    private static string NormalizeRemotePath(string path)
    {
        path = (path ?? "/").Replace('\\', '/').Trim();
        if (path.Length == 0) return "/";
        if (!path.StartsWith('/')) path = "/" + path;
        while (path.Contains("//", StringComparison.Ordinal)) path = path.Replace("//", "/");
        return path.Length > 1 ? path.TrimEnd('/') : path;
    }

    private static bool IsLocalPane(PaneModel? pane) =>
        pane?.Site.Equals("local", StringComparison.OrdinalIgnoreCase) == true;

    private static string LocalStartPath()
    {
        if (OperatingSystem.IsWindows()) return "";
        return "/";
    }

    private static IReadOnlyList<string> LocalRoots()
    {
        if (OperatingSystem.IsWindows())
            return DriveInfo.GetDrives()
                .Where(d => d.IsReady || d.DriveType is DriveType.Fixed or DriveType.Removable or DriveType.Network)
                .Select(d => d.RootDirectory.FullName)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(d => d, StringComparer.OrdinalIgnoreCase)
                .ToList();
        return new[] { "/" };
    }

    private static string LocalParentPath(string path)
    {
        path = string.IsNullOrWhiteSpace(path) ? LocalStartPath() : path;
        var root = Path.GetPathRoot(path);
        if (OperatingSystem.IsWindows() && (string.IsNullOrWhiteSpace(path) || path == "/" || path.Equals(root, StringComparison.OrdinalIgnoreCase)))
            return "";
        if (!string.IsNullOrEmpty(root) && path.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar).Equals(root.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar), StringComparison.OrdinalIgnoreCase))
            return root;
        return Directory.GetParent(path)?.FullName ?? root ?? path;
    }

    private static List<RemoteEntry> ListLocal(string path)
    {
        if (OperatingSystem.IsWindows() && string.IsNullOrWhiteSpace(path))
        {
            return DriveInfo.GetDrives()
                .Select(d => new RemoteEntry
                {
                    Name = d.Name.TrimEnd('\\'),
                    Path = d.RootDirectory.FullName,
                    Type = "dir",
                    Modified = DateTime.MinValue,
                })
                .ToList();
        }

        path = string.IsNullOrWhiteSpace(path) ? LocalStartPath() : path;
        var entries = new List<RemoteEntry>();
        foreach (var dir in SafeEnumerateDirectories(path))
        {
            var info = new DirectoryInfo(dir);
            entries.Add(new RemoteEntry { Name = info.Name, Path = info.FullName, Type = "dir", Modified = info.LastWriteTimeUtc });
        }
        foreach (var file in SafeEnumerateFiles(path))
        {
            var info = new FileInfo(file);
            entries.Add(new RemoteEntry { Name = info.Name, Path = info.FullName, Type = "file", Size = info.Length, Modified = info.LastWriteTimeUtc });
        }
        return entries;
    }

    private static IEnumerable<string> SafeEnumerateDirectories(string path)
    {
        try { return Directory.EnumerateDirectories(path); }
        catch { return Enumerable.Empty<string>(); }
    }

    private static IEnumerable<string> SafeEnumerateFiles(string path)
    {
        try { return Directory.EnumerateFiles(path); }
        catch { return Enumerable.Empty<string>(); }
    }

    private static string EntryPath(PaneModel pane, RemoteEntry entry)
    {
        if (!string.IsNullOrEmpty(entry.Path)) return entry.Path;
        return IsLocalPane(pane) ? Path.Combine(pane.Path, entry.Name) : PJoin(pane.Path, entry.Name);
    }

    private static void ClearCompare(PaneModel pane)
    {
        pane.CompareMissing.Clear();
        pane.CompareDifferent.Clear();
        pane.CompareSame.Clear();
    }

    // ---- browse operations ----

    private Task ToggleLocalPane(PaneModel pane)
    {
        if (IsLocalPane(pane))
            return SelectPaneSite(pane, "");

        if (!string.IsNullOrWhiteSpace(pane.Site))
        {
            CancelLocalTransfersForDisconnectedSite(pane.Site);
            pane.LastSite = pane.Site;
        }
        return ConnectPane(pane, "local");
    }

    private Task SelectPaneSite(PaneModel pane, string site)
    {
        site = site?.Trim() ?? "";
        if (string.IsNullOrWhiteSpace(site))
            CancelLocalTransfersForDisconnectedSite(pane.Site);
        if (!string.IsNullOrWhiteSpace(site))
            pane.LastSite = site;

        pane.Site = site;
        var selectedSite = _sites.FirstOrDefault(x => x.Name.Equals(site, StringComparison.OrdinalIgnoreCase));
        pane.Path = string.IsNullOrEmpty(selectedSite?.BasePath) ? "/" : selectedSite.BasePath;
        pane.Entries.Clear();
        pane.Selected.Clear();
        ClearCompare(pane);
        pane.Loaded = false;
        pane.Loading = false;
        pane.Error = null;
        pane.Status = string.IsNullOrWhiteSpace(site) ? "Disconnected" : $"Ready to connect to {site}";
        PersistBrowserState();
        return Task.CompletedTask;
    }

    private async Task ConnectPane(PaneModel pane, string site)
    {
        if (string.IsNullOrEmpty(site))
        {
            DisconnectPane(pane);
            return;
        }

        if (!site.Equals("local", StringComparison.OrdinalIgnoreCase))
            pane.LastSite = site;
        pane.Site = site;
        if (IsLocalPane(pane))
            pane.Path = LocalStartPath();
        else
        {
            var s = _sites.FirstOrDefault(x => x.Name == site);
            pane.Path = string.IsNullOrEmpty(s?.BasePath) ? "/" : s!.BasePath;
        }
        await ListPane(pane);
    }

    private void DisconnectPane(PaneModel pane)
    {
        CancelLocalTransfersForDisconnectedSite(pane.Site);
        pane.Site = "";
        pane.Path = "/";
        pane.Entries.Clear();
        pane.Selected.Clear();
        ClearCompare(pane);
        pane.Loaded = false;
        pane.Loading = false;
        pane.Error = null;
        pane.Status = "Disconnected";
        PersistBrowserState();
    }

    private void CancelLocalTransfersForDisconnectedSite(string site)
    {
        if (string.IsNullOrWhiteSpace(site) || site.Equals("local", StringComparison.OrdinalIgnoreCase)) return;
        var cancelled = Engine.CancelLocalTransfersForSite(site, "Disconnected from browser pane");
        if (cancelled > 0)
            Toast($"Cancelled {cancelled} local transfer(s) for {site}");
    }

    private async Task JumpSection(PaneModel pane, string section)
    {
        if (IsLocalPane(pane))
        {
            if (string.IsNullOrWhiteSpace(section)) return;
            pane.Path = section;
            await ListPane(pane);
            return;
        }
        if (string.IsNullOrEmpty(pane.Site) || string.IsNullOrEmpty(section)) return;
        pane.Path = section;
        await ListPane(pane);
    }

    private void SetPanePath(PaneModel pane, string path)
    {
        pane.Path = string.IsNullOrWhiteSpace(path) ? (IsLocalPane(pane) ? "" : "/") : path.Trim();
        PersistBrowserState();
    }

    private async Task ListPane(PaneModel pane, bool silent = false)
    {
        if (pane.Loading || string.IsNullOrEmpty(pane.Site)) return;
        pane.Loading = true;
        pane.Error = null;
        pane.Status = IsLocalPane(pane) ? $"Opening {pane.Path}..." : $"Connecting to {pane.Site}…";
        await InvokeAsync(StateHasChanged);
        try
        {
            var entries = IsLocalPane(pane)
                ? await Task.Run(() => ListLocal(pane.Path))
                : await Engine.ListRemoteAsync(pane.Site, pane.Path, BrowseLogName(pane));
            pane.Entries = entries;
            ApplySort(pane);
            pane.Selected.Clear();
            ClearCompare(pane);
            pane.Loaded = true;
            UpdatePaneStatus(pane);
        }
        catch (Exception ex)
        {
            pane.Error = ex.Message;
            pane.Status = "Error";
            if (!silent) Toast(ex.Message);
        }
        pane.Loading = false;
        PersistBrowserState();
    }

    private void UpdatePaneStatus(PaneModel pane)
    {
        var dirs = pane.Entries.Count(e => e.Type == "dir");
        var files = pane.Entries.Count - dirs;
        var bytes = pane.Entries.Where(e => e.Type != "dir").Sum(e => e.Size);
        var sel = pane.Selected.Count > 0 ? $" — {pane.Selected.Count} selected" : "";
        pane.Status = $"{dirs} dirs, {files} files, {HumanSize(bytes)}{sel}";
    }

    private async Task OpenEntry(PaneModel pane, int index)
    {
        if (index < 0 || index >= pane.Entries.Count) return;
        var entry = pane.Entries[index];
        // Follow directories and symlinks (scene sections are full of symlinks that
        // point at the real release dirs). CWD on the server resolves the link.
        if (entry.Type is "dir" or "link")
        {
            pane.Path = string.IsNullOrEmpty(entry.Path)
                ? (IsLocalPane(pane) ? Path.Combine(pane.Path, entry.Name) : PJoin(pane.Path, entry.Name))
                : entry.Path;
            await ListPane(pane);
        }
    }

    private async Task GoUp(PaneModel pane)
    {
        if (string.IsNullOrEmpty(pane.Site)) return;
        pane.Path = IsLocalPane(pane) ? LocalParentPath(pane.Path) : ParentPath(pane.Path);
        await ListPane(pane);
    }

    private void ToggleSelect(PaneModel pane, int index, MouseEventArgs e)
    {
        if (e.ShiftKey && pane.Anchor >= 0 && pane.Anchor < pane.Entries.Count)
        {
            // Range select from the anchor to the clicked row — folders and files alike.
            var from = Math.Min(pane.Anchor, index);
            var to = Math.Max(pane.Anchor, index);
            if (!(e.CtrlKey || e.MetaKey)) pane.Selected.Clear();
            for (var i = from; i <= to; i++) pane.Selected.Add(i);
        }
        else if (e.CtrlKey || e.MetaKey)
        {
            if (!pane.Selected.Add(index)) pane.Selected.Remove(index);
            pane.Anchor = index;
        }
        else
        {
            pane.Selected.Clear();
            pane.Selected.Add(index);
            pane.Anchor = index;
        }
        UpdatePaneStatus(pane);
    }

    private void SortPane(PaneModel pane, string column)
    {
        if (pane.SortColumn.Equals(column, StringComparison.OrdinalIgnoreCase))
            pane.SortDesc = !pane.SortDesc;
        else
        {
            pane.SortColumn = column;
            pane.SortDesc = false;
        }
        ApplySort(pane);
        pane.Selected.Clear();
        UpdatePaneStatus(pane);
        PersistBrowserState();
    }

    private static void ApplySort(PaneModel pane)
    {
        var dirsFirst = pane.Entries.OrderBy(e => e.Type == "dir" ? 0 : 1);
        IOrderedEnumerable<RemoteEntry> sorted = pane.SortColumn switch
        {
            "size" => pane.SortDesc
                ? dirsFirst.ThenByDescending(e => e.Size).ThenBy(e => e.Name, StringComparer.OrdinalIgnoreCase)
                : dirsFirst.ThenBy(e => e.Size).ThenBy(e => e.Name, StringComparer.OrdinalIgnoreCase),
            "modified" => pane.SortDesc
                ? dirsFirst.ThenByDescending(e => e.Modified).ThenBy(e => e.Name, StringComparer.OrdinalIgnoreCase)
                : dirsFirst.ThenBy(e => e.Modified).ThenBy(e => e.Name, StringComparer.OrdinalIgnoreCase),
            "owner" => pane.SortDesc
                ? dirsFirst.ThenByDescending(e => e.Owner, StringComparer.OrdinalIgnoreCase).ThenBy(e => e.Name, StringComparer.OrdinalIgnoreCase)
                : dirsFirst.ThenBy(e => e.Owner, StringComparer.OrdinalIgnoreCase).ThenBy(e => e.Name, StringComparer.OrdinalIgnoreCase),
            "group" => pane.SortDesc
                ? dirsFirst.ThenByDescending(e => e.Group, StringComparer.OrdinalIgnoreCase).ThenBy(e => e.Name, StringComparer.OrdinalIgnoreCase)
                : dirsFirst.ThenBy(e => e.Group, StringComparer.OrdinalIgnoreCase).ThenBy(e => e.Name, StringComparer.OrdinalIgnoreCase),
            _ => pane.SortDesc
                ? dirsFirst.ThenByDescending(e => e.Name, StringComparer.OrdinalIgnoreCase)
                : dirsFirst.ThenBy(e => e.Name, StringComparer.OrdinalIgnoreCase),
        };
        pane.Entries = sorted.ToList();
    }

    private void QueueFxp(PaneModel source, PaneModel dest)
    {
        if (string.IsNullOrEmpty(source.Site)) { Toast("Source browse has no site"); return; }
        if (string.IsNullOrEmpty(dest.Site)) { Toast("Destination browse has no site"); return; }
        if (source.Site == dest.Site) { Toast("Source and destination are the same site"); return; }
        var picks = source.Selected.Select(i => source.Entries[i]).ToList();
        if (picks.Count == 0) { Toast("Select files or directories first"); return; }

        var queued = 0;
        foreach (var entry in picks)
        {
            var src = EntryPath(source, entry);
            var dst = IsLocalPane(dest) ? Path.Combine(dest.Path, entry.Name) : PJoin(dest.Path, entry.Name);
            try
            {
                if (IsLocalPane(source) && !IsLocalPane(dest))
                {
                    Engine.StartUpload(new UploadRequest
                    {
                        Site = dest.Site,
                        SourcePath = src,
                        DestPath = dst,
                    });
                }
                else if (!IsLocalPane(source) && IsLocalPane(dest))
                {
                    Engine.StartDownload(new DownloadRequest
                    {
                        Site = source.Site,
                        SourcePath = src,
                        DestPath = dst,
                    });
                }
                else if (!IsLocalPane(source) && !IsLocalPane(dest))
                {
                    Engine.StartFxp(new TransferRequest
                    {
                        FromSite = source.Site,
                        ToSite = dest.Site,
                        SourcePath = src,
                        DestPath = dst,
                    });
                }
                else
                {
                    Toast("Local to local transfer is not queued here");
                    continue;
                }
                queued++;
            }
            catch (Exception ex) { Toast($"{entry.Name}: {ex.Message}"); }
        }
        if (queued > 0)
        {
            Toast($"Queued {queued} transfer(s) {source.Site} → {dest.Site}");
            _tab = "queue";
        }
    }

