@page "/history"
@inject WeaveEngine Engine

<h1 class="visually-hidden">History</h1>

<div class="page history-page">
    <header class="page-head page-head-lg">
        <div>
            <div class="eyebrow">Stored Activity</div>
            <h2><span class="title-icon">◷</span> History</h2>
            <p class="page-sub">@_jobs.Count transfer job(s) stored.</p>
        </div>
        <div class="page-actions">
            <button class="secondary" @onclick="Refresh"><span class="btn-icon">↻</span> Refresh</button>
        </div>
    </header>

    <section class="content-panel">
        <div class="toolbar">
            <input placeholder="Search site, path, release..." @bind="_query" @bind:event="oninput" @bind:after="FilterChanged" />
            <select @bind="_state" @bind:after="FilterChanged">
                <option value="">All states</option>
                @foreach (var s in Enum.GetValues<JobState>())
                {
                    <option value="@s">@s</option>
                }
            </select>
            <span class="spacer"></span>
            <span class="hint">@PageLabel</span>
            <select class="page-size" @bind="_pageSize" @bind:after="FilterChanged">
                <option value="20">20 lines</option>
                <option value="50">50 lines</option>
                <option value="100">100 lines</option>
                <option value="200">200 lines</option>
            </select>
        </div>

        <div class="table-wrap">
            <table class="data-table history-transfers-table">
                <colgroup>
                    <col class="hist-col-created" />
                    <col class="hist-col-state" />
                    <col class="hist-col-type" />
                    <col class="hist-col-release" />
                    <col class="hist-col-section" />
                    <col class="hist-col-route" />
                    <col class="hist-col-path" />
                    <col class="hist-col-path" />
                    <col class="hist-col-result" />
                </colgroup>
                <thead>
                    <tr>
                        <th>Created</th>
                        <th>State</th>
                        <th>Type</th>
                        <th>Release</th>
                        <th>Section</th>
                        <th>Route</th>
                        <th>Source</th>
                        <th>Destination</th>
                        <th>Result</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var job in PagedJobs)
                    {
                        <tr>
                            <td class="mono">@Local(job.CreatedAt)</td>
                            <td><span class="pill @StateClass(job.State)">@job.State</span></td>
                            <td>@job.Type</td>
                            <td class="strong" title="@ReleaseName(job)">@ReleaseName(job)</td>
                            <td class="mono" title="@SectionNames(job)">@SectionNames(job)</td>
                            <td class="strong">@job.Request.FromSite → @job.Request.ToSite</td>
                            <td class="mono" title="@job.Request.SourcePath">@job.Request.SourcePath</td>
                            <td class="mono" title="@job.Request.DestPath">@job.Request.DestPath</td>
                            <td class="dim" title="@JobDetail(job)">@JobDetail(job)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

@code {
    private List<Job> _jobs = new();
    private List<Site> _sites = new();
    private readonly Dictionary<string, string> _sectionNames = new(StringComparer.OrdinalIgnoreCase);
    private string _query = "";
    private string _state = "";
    private int _pageSize = 50;

    private IEnumerable<Job> FilteredJobs => _jobs
        .Where(j => string.IsNullOrEmpty(_state) || j.State.ToString() == _state)
        .Where(j => Matches($"{j.Request.FromSite} {j.Request.ToSite} {j.Request.SourcePath} {j.Request.DestPath} {ReleaseName(j)} {SectionNames(j)} {j.Error}"));

    private IEnumerable<Job> PagedJobs => FilteredJobs.Take(_pageSize);
    private string PageLabel => $"{FilteredJobs.Count()} transfer row(s)";

    protected override void OnInitialized()
    {
        Refresh();
    }

    private void Refresh()
    {
        _jobs = Engine.HistoryJobs();
        _sites = Engine.Sites(true);
        BuildSectionMap();
    }

    private void FilterChanged() => Refresh();
    private bool Matches(string value) => string.IsNullOrWhiteSpace(_query) || value.Contains(_query, StringComparison.OrdinalIgnoreCase);
    private static string Local(DateTime dt) => dt == default ? "" : dt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss");
    private static string StateClass(JobState s) => s switch { JobState.Succeeded => "on", JobState.Failed => "off", JobState.Running => "busy", _ => "" };
    private static string JobDetail(Job job) => job.State switch
    {
        JobState.Succeeded => "job completed",
        JobState.Failed => string.IsNullOrWhiteSpace(job.Error) ? "job failed" : "job failed",
        JobState.Cancelled => "job cancelled",
        JobState.Running => "running",
        JobState.Queued => "queued",
        _ => job.State.ToString()
    };

    private void BuildSectionMap()
    {
        _sectionNames.Clear();
        foreach (var site in _sites)
            foreach (var sec in site.Sections)
            {
                var path = NormalizeSectionPath(sec.Section);
                if (path.Length == 0 || string.IsNullOrWhiteSpace(sec.Name)) continue;
                _sectionNames[site.Name + "|" + path] = sec.Name;
            }
    }

    private string SectionNames(Job job)
    {
        var src = SectionNameFor(job.Request.FromSite, ParentPath(job.Request.SourcePath));
        var dst = SectionNameFor(job.Request.ToSite, ParentPath(job.Request.DestPath));
        return src.Equals(dst, StringComparison.OrdinalIgnoreCase) ? src : $"{src} → {dst}";
    }

    private string SectionNameFor(string site, string path)
    {
        var normalized = NormalizeSectionPath(path);
        return _sectionNames.TryGetValue(site + "|" + normalized, out var name) ? name : normalized;
    }

    private static string ReleaseName(Job job)
    {
        var path = (job.Request.SourcePath ?? "").TrimEnd('/');
        var i = path.LastIndexOf('/');
        var name = i >= 0 ? path[(i + 1)..] : path;
        if (!string.IsNullOrWhiteSpace(name)) return name;
        path = (job.Request.DestPath ?? "").TrimEnd('/');
        i = path.LastIndexOf('/');
        return i >= 0 ? path[(i + 1)..] : path;
    }

    private static string ParentPath(string path)
    {
        path = (path ?? "").TrimEnd('/');
        if (path.Length == 0) return "/";
        var i = path.LastIndexOf('/');
        return i <= 0 ? "/" : path[..i];
    }

    private static string NormalizeSectionPath(string p)
    {
        p = (p ?? "").Trim();
        if (p.Length > 1) p = p.TrimEnd('/');
        return p;
    }
}
