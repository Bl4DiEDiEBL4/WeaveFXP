@page "/races"
@implements IDisposable
@inject WeaveEngine Engine

<h1 class="visually-hidden">Races</h1>

<div class="page races-page">
    <header class="page-head page-head-lg">
        <div>
            <div class="eyebrow">Racing</div>
            <h2><span class="title-icon">⚑</span> Races</h2>
            <p class="page-sub">@ActiveGroups.Count running · @FilteredGroups.Count race(s) total. The browser queue only shows manual transfers.</p>
        </div>
        <div class="page-actions">
            <button class="secondary" @onclick="Refresh"><span class="btn-icon">↻</span> Refresh</button>
        </div>
    </header>

    <section class="content-panel">
        <div class="toolbar">
            <input placeholder="Search release, site, path..." @bind="_query" @bind:event="oninput" />
            <select @bind="_state">
                <option value="">All states</option>
                @foreach (var s in Enum.GetValues<JobState>())
                {
                    <option value="@s">@s</option>
                }
            </select>
            <span class="spacer"></span>
            <span class="hint">@FilteredGroups.Count race(s)</span>
        </div>

        <div class="table-wrap">
            <table class="data-table races-table">
                <colgroup>
                    <col class="race-col-time" />
                    <col class="race-col-state" />
                    <col class="race-col-runtime" />
                    <col class="race-col-release" />
                    <col class="race-col-route" />
                    <col class="race-col-section" />
                    <col class="race-col-progress" />
                    <col class="race-col-actions" />
                </colgroup>
                <thead>
                    <tr>
                        <th class="col-time">Started</th>
                        <th class="col-state">State</th>
                        <th class="col-runtime">Runtime</th>
                        <th class="col-release">Release</th>
                        <th class="col-route">Route</th>
                        <th class="col-section">Section</th>
                        <th class="col-progress">Progress</th>
                        <th class="col-actions"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (FilteredGroups.Count == 0)
                    {
                        <tr><td colspan="8" class="dim">No races yet. Start one from the browser (race spread) or over the API.</td></tr>
                    }
                    @foreach (var race in FilteredGroups.Take(200))
                    {
                        <tr id="race-@race.Primary.Id" class="race-row @(IsOpen(race) ? "open" : "")" @onclick="() => ToggleLog(race)">
                            <td class="mono col-time">@Local(RaceCreatedAt(race))</td>
                            <td class="col-state">
                                <span class="pill @StateClass(RaceState(race))" title="@RaceError(race)">@RaceState(race)</span>
                                @if (RacePaused(race))
                                {
                                    <span class="pill amber">paused</span>
                                }
                            </td>
                            <td class="mono col-runtime">@RaceRuntime(race)</td>
                            <td class="strong race-name" title="@RacePathTitle(race)">@RaceName(race.Primary)</td>
                            <td class="col-route">@RaceRoute(race)</td>
                            <td class="mono race-section" title="@RacePathTitle(race)">@RaceSections(race)</td>
                            <td class="col-progress">
                                @if (RaceState(race) == JobState.Running)
                                {
                                    <span class="job-prog wide">
                                        <span class="job-bar">
                                            <span class="job-bar-fill @(RaceTotalFiles(race) <= 0 ? "indet" : "")"
                                                  style="width:@RacePercent(race)%"></span>
                                        </span>
                                        <span class="job-prog-text">@ProgressText(race)</span>
                                    </span>
                                }
                                else if (HasRaceProgress(race))
                                {
                                    <span class="job-prog wide">
                                        <span class="job-bar">
                                            <span class="job-bar-fill" style="width:@RacePercent(race)%"></span>
                                        </span>
                                        <span class="job-prog-text">@ProgressText(race)</span>
                                    </span>
                                }
                                else
                                {
                                    <span class="dim">—</span>
                                }
                            </td>
                            <td class="col-actions" @onclick:stopPropagation="true">
                                @if (RaceActive(race))
                                {
                                    @if (RacePaused(race))
                                    {
                                        <button class="secondary slim" @onclick="() => Resume(race)">Resume</button>
                                    }
                                    else
                                    {
                                        <button class="secondary slim" @onclick="() => Pause(race)">Pause</button>
                                    }
                                    <button class="secondary slim danger" @onclick="() => Stop(race)">Stop</button>
                                }
                                else
                                {
                                    <button class="secondary slim" @onclick="() => Retry(race)">Retry</button>
                                    <button class="secondary slim danger" @onclick="() => Remove(race)">Remove</button>
                                }
                            </td>
                        </tr>
                        @if (IsOpen(race))
                        {
                            <tr class="race-log-row">
                                <td colspan="8">
                                    <div class="race-mesh-summary">
                                        <div class="race-site-list">
                                            <span class="race-summary-label">Sites</span>
                                            @foreach (var site in RaceSites(race))
                                            {
                                                <span class="race-site-chip">@site</span>
                                            }
                                        </div>
                                        <div class="race-route-list">
                                            <span class="race-summary-label">Routes</span>
                                            @foreach (var route in RaceRoutes(race))
                                            {
                                                <span class="race-route-chip">
                                                    <strong>@route.From → @route.To</strong>
                                                    <span>@route.Done raced</span>
                                                    @if (route.Active > 0) { <span>@route.Active active</span> }
                                                    @if (route.Bytes > 0) { <span>@HumanSize(route.Bytes)</span> }
                                                </span>
                                            }
                                        </div>
                                    </div>
                                    @if (RaceFiles(race).Count > 0)
                                    {
                                        <table class="data-table file-table">
                                            <colgroup>
                                                <col class="file-col-started" />
                                                <col class="file-col-use" />
                                                <col class="file-col-route" />
                                                <col class="file-col-path" />
                                                <col class="file-col-transferred" />
                                                <col class="file-col-name" />
                                                <col class="file-col-left" />
                                                <col class="file-col-speed" />
                                                <col class="file-col-done" />
                                            </colgroup>
                                            <thead>
                                                <tr>
                                                    <th>Started</th>
                                                    <th>Use</th>
                                                    <th>Route</th>
                                                    <th>Path</th>
                                                    <th>Transferred</th>
                                                    <th>File</th>
                                                    <th>Left</th>
                                                    <th>Speed</th>
                                                    <th>Done</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var row in RaceFiles(race))
                                                {
                                                    var ft = row.Transfer;
                                                    <tr>
                                                        <td class="mono">@ft.StartedAt.ToLocalTime().ToString("HH:mm:ss")</td>
                                                        <td class="mono">@Elapsed(ft)</td>
                                                        <td class="mono route-cell">@FileRoute(row)</td>
                                                        <td class="mono path-cell" title="@TransferPath(row.Job, ft)">@TransferPath(row.Job, ft)</td>
                                                        <td class="mono transferred-cell">@Transferred(ft)</td>
                                                        <td class="mono file-name" title="@FileTitle(ft)">@ft.Name</td>
                                                        <td class="mono">@Left(ft)</td>
                                                        <td class="mono">@FileSpeed(ft)</td>
                                                        <td><span class="pill @FileStatusClass(ft.Status)">@Done(ft)</span></td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    }
                                    @foreach (var job in race.Jobs)
                                    {
                                        <details class="race-raw-log">
                                            <summary>@RaceRoute(job) · Raw log (@job.Events.Count lines)</summary>
                                            <ul class="events">
                                                @foreach (var ev in job.Events)
                                                {
                                                    <li class="lvl-@ev.Level">[@ev.Time.ToLocalTime().ToString("HH:mm:ss")] @ev.Level: @ev.Message</li>
                                                }
                                            </ul>
                                        </details>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

@if (_toast is not null)
{
    <div class="toast show" @key="_toast">@_toast</div>
}

@code {
    private sealed record RaceGroup(string Key, List<Job> Jobs)
    {
        public Job Primary => Jobs[0];
    }

    private sealed record RaceFileRow(Job Job, FileTransfer Transfer);
    private sealed class RouteSummary
    {
        public required string From { get; init; }
        public required string To { get; init; }
        public int Done { get; set; }
        public int Active { get; set; }
        public long Bytes { get; set; }
    }

    private List<Job> _jobs = new();
    private List<RaceGroup> _raceGroups = new();
    private List<Site> _sites = new();
    // path (e.g. "/!Today_FLAC") on a given site -> its configured section NAME.
    private readonly Dictionary<string, string> _sectionNames = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _open = new(StringComparer.OrdinalIgnoreCase);
    private string _query = "";
    private string _state = "";
    private string? _toast;

    [SupplyParameterFromQuery(Name = "job")]
    public string? SelectedJobId { get; set; }

    private static string Local(DateTime dt) => dt == default ? "" : dt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss");

    protected override void OnInitialized()
    {
        _sites = Engine.Sites(true);
        BuildSectionMap();
        Refresh();
        Engine.Changed += OnChanged;
    }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(SelectedJobId))
            _open.Add(SelectedJobId);
    }

    private void BuildSectionMap()
    {
        _sectionNames.Clear();
        foreach (var site in _sites)
            foreach (var sec in site.Sections)
            {
                var path = NormalizeSectionPath(sec.Section);
                if (path.Length == 0 || string.IsNullOrWhiteSpace(sec.Name)) continue;
                _sectionNames[site.Name + "|" + path] = sec.Name;
            }
    }

    private static string NormalizeSectionPath(string p)
    {
        p = (p ?? "").Trim();
        if (p.Length > 1) p = p.TrimEnd('/');
        return p;
    }

    public void Dispose() => Engine.Changed -= OnChanged;

    private int _refreshQueued;

    private void OnChanged()
    {
        if (Interlocked.Exchange(ref _refreshQueued, 1) != 0) return;
        _ = InvokeAsync(() =>
        {
            Interlocked.Exchange(ref _refreshQueued, 0);
            Refresh();
            StateHasChanged();
        });
    }

    private void Refresh()
    {
        _jobs = Engine.Jobs();
        _raceGroups = _jobs
            .Where(j => j.Type == JobType.Race)
            .GroupBy(j => string.IsNullOrWhiteSpace(j.BatchId) ? j.Id : j.BatchId, StringComparer.OrdinalIgnoreCase)
            .Select(g => new RaceGroup(g.Key, g.OrderBy(j => j.CreatedAt).ToList()))
            .OrderByDescending(RaceCreatedAt)
            .ToList();
    }

    private List<RaceGroup> RaceGroups => _raceGroups;

    private List<RaceGroup> FilteredGroups
    {
        get
        {
            IEnumerable<RaceGroup> q = RaceGroups;
            if (!string.IsNullOrWhiteSpace(_state) && Enum.TryParse<JobState>(_state, out var st))
                q = q.Where(r => RaceState(r) == st);
            if (!string.IsNullOrWhiteSpace(_query))
            {
                var needle = _query.Trim();
                q = q.Where(r => r.Jobs.Any(j =>
                    RaceName(j).Contains(needle, StringComparison.OrdinalIgnoreCase) ||
                    j.Request.SourcePath.Contains(needle, StringComparison.OrdinalIgnoreCase) ||
                    j.Request.DestPath.Contains(needle, StringComparison.OrdinalIgnoreCase) ||
                    j.Request.FromSite.Contains(needle, StringComparison.OrdinalIgnoreCase) ||
                    j.Request.ToSite.Contains(needle, StringComparison.OrdinalIgnoreCase) ||
                    j.Request.MeshSites.Any(s => s.Contains(needle, StringComparison.OrdinalIgnoreCase))));
            }
            return q.ToList();
        }
    }

    private List<RaceGroup> ActiveGroups => RaceGroups.Where(RaceActive).ToList();

    private bool IsOpen(RaceGroup race) =>
        _open.Contains(race.Key) || race.Jobs.Any(j => _open.Contains(j.Id));

    private void ToggleLog(RaceGroup race)
    {
        var open = IsOpen(race);
        _open.Remove(race.Key);
        foreach (var job in race.Jobs) _open.Remove(job.Id);
        if (!open) _open.Add(race.Key);
    }

    private static List<RaceFileRow> RaceFiles(RaceGroup race) =>
        race.Jobs
            .SelectMany(j => j.Files
                .Where(f => !IsMissingMarkerRow(f))
                .Select(f => new RaceFileRow(j, f)))
            .OrderByDescending(x => x.Transfer.StartedAt)
            .ToList();

    private static string Elapsed(FileTransfer ft)
    {
        var secs = ft.Status == "active" ? (DateTime.UtcNow - ft.StartedAt).TotalSeconds : ft.Seconds;
        if (secs <= 0) return "—";
        return secs < 10 ? $"{secs:0.0}s" : $"{secs:0}s";
    }

    private static string FileSpeed(FileTransfer ft)
    {
        if (ft.Status == "active")
        {
            // Live estimate while the file is in flight: size over elapsed so far.
            var secs = (DateTime.UtcNow - ft.StartedAt).TotalSeconds;
            return ft.Size > 0 && secs > 0.3 ? "≤" + Speed(ft.Size / secs) : "…";
        }
        return ft.Bps > 0 ? Speed(ft.Bps) : "—";
    }

    private static string FileTitle(FileTransfer ft) =>
        string.IsNullOrWhiteSpace(ft.Error) ? ft.Name : $"{ft.Name} - {ft.Error}";

    private static string TransferPath(Job job, FileTransfer ft)
    {
        var sourceBase = SitePath(job, ft.FromSite, job.Request.SourcePath);
        var destBase = SitePath(job, ft.ToSite, job.Request.DestPath);
        var source = JoinRemote(ParentPath(sourceBase), ParentPath(ft.Name));
        var dest = JoinRemote(ParentPath(destBase), ParentPath(ft.Name));
        return source.Equals(dest, StringComparison.OrdinalIgnoreCase) ? source : $"{source} → {dest}";
    }

    private static string SitePath(Job job, string site, string fallback)
    {
        if (!string.IsNullOrWhiteSpace(site) &&
            job.Request.SitePaths.TryGetValue(site, out var path) &&
            !string.IsNullOrWhiteSpace(path))
            return path;
        return fallback;
    }

    private static string FileRoute(RaceFileRow row) =>
        !string.IsNullOrWhiteSpace(row.Transfer.FromSite) && !string.IsNullOrWhiteSpace(row.Transfer.ToSite)
            ? $"{row.Transfer.FromSite} → {row.Transfer.ToSite}"
            : RaceRoute(row.Job);

    private static string Transferred(FileTransfer ft) =>
        ft.Status == "done"
            ? $"{HumanSize(ft.Size)} / {HumanSize(ft.Size)}"
            : $"— / {HumanSize(ft.Size)}";

    private static string Left(FileTransfer ft) => ft.Status == "active" ? "…" : "—";

    private static string Done(FileTransfer ft) => ft.Status switch
    {
        "done" => "done",
        "fail" => "fail",
        "active" => "active",
        "expected" => "expected",
        "queued" => "queued",
        "dupe" => "dupe",
        _ => ft.Status
    };

    private static string FileStatusClass(string status) => status switch
    {
        "done" => "green",
        "fail" => "red",
        "active" => "cyan",
        "expected" => "amber",
        "queued" => "amber",
        _ => "amber", // dupe / wait
    };

    private static string RaceName(Job job)
    {
        var p = (job.Request.SourcePath ?? "").TrimEnd('/');
        var i = p.LastIndexOf('/');
        var name = i >= 0 ? p[(i + 1)..] : p;
        return string.IsNullOrWhiteSpace(name) ? job.Request.SourcePath ?? "" : name;
    }

    // Show the site's configured section NAME (e.g. "FLAC"), not the raw path.
    // Falls back to the path when the section isn't configured on the site.
    private string RaceSections(Job job)
    {
        if (job.Request.MeshSites.Count > 1)
        {
            var meshSrc = SectionNameFor(job.Request.FromSite, ParentPath(job.Request.SourcePath));
            var meshDst = SectionNameFor(job.Request.MeshSites.FirstOrDefault(s => !s.Equals(job.Request.FromSite, StringComparison.OrdinalIgnoreCase)) ?? job.Request.FromSite, ParentPath(job.Request.DestPath));
            return meshSrc.Equals(meshDst, StringComparison.OrdinalIgnoreCase) ? meshSrc : $"{meshSrc} → {meshDst}";
        }
        var src = SectionNameFor(job.Request.FromSite, ParentPath(job.Request.SourcePath));
        var dst = SectionNameFor(job.Request.ToSite, ParentPath(job.Request.DestPath));
        return src.Equals(dst, StringComparison.OrdinalIgnoreCase) ? src : $"{src} → {dst}";
    }

    private string RaceSections(RaceGroup race) => string.Join(" / ", race.Jobs
        .Select(RaceSections)
        .Where(s => !string.IsNullOrWhiteSpace(s))
        .Distinct(StringComparer.OrdinalIgnoreCase));

    private static string RaceRoute(Job job) =>
        job.Request.MeshSites.Count > 1
            ? string.Join(" ↔ ", job.Request.MeshSites)
            : $"{job.Request.FromSite} → {job.Request.ToSite}";

    private static List<string> RaceSites(RaceGroup race) => race.Jobs
        .SelectMany(j => j.Request.MeshSites.Count > 1
            ? j.Request.MeshSites.AsEnumerable()
            : new[] { j.Request.FromSite, j.Request.ToSite })
        .Where(s => !string.IsNullOrWhiteSpace(s))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToList();

    private static string RaceRoute(RaceGroup race) => string.Join(" ↔ ", RaceSites(race));

    private List<RouteSummary> RaceRoutes(RaceGroup race)
    {
        var routes = new Dictionary<string, RouteSummary>(StringComparer.OrdinalIgnoreCase);
        void Add(string from, string to)
        {
            if (string.IsNullOrWhiteSpace(from) || string.IsNullOrWhiteSpace(to) || from.Equals(to, StringComparison.OrdinalIgnoreCase)) return;
            var key = from + "|" + to;
            routes.TryAdd(key, new RouteSummary { From = from, To = to });
        }

        foreach (var job in race.Jobs)
        {
            if (job.Request.MeshSites.Count > 1)
            {
                var sites = job.Request.MeshSites
                    .Select(name => _sites.FirstOrDefault(s => s.Name.Equals(name, StringComparison.OrdinalIgnoreCase)))
                    .Where(s => s is not null)
                    .Cast<Site>()
                    .ToList();
                foreach (var from in sites)
                    foreach (var to in sites)
                        if (Engine.TransferAllowed(from, to)) Add(from.Name, to.Name);
            }
            else Add(job.Request.FromSite, job.Request.ToSite);
        }

        foreach (var row in RaceFiles(race))
        {
            var ft = row.Transfer;
            var from = string.IsNullOrWhiteSpace(ft.FromSite) ? row.Job.Request.FromSite : ft.FromSite;
            var to = string.IsNullOrWhiteSpace(ft.ToSite) ? row.Job.Request.ToSite : ft.ToSite;
            Add(from, to);
            if (!routes.TryGetValue(from + "|" + to, out var route)) continue;
            if (ft.Status == "done") { route.Done++; route.Bytes += Math.Max(0, ft.Size); }
            if (ft.Status == "active") route.Active++;
        }
        return routes.Values.OrderBy(r => r.From).ThenBy(r => r.To).ToList();
    }

    private static DateTime RaceCreatedAt(RaceGroup race) => race.Jobs.Min(j => j.CreatedAt);

    private static JobState RaceState(RaceGroup race)
    {
        if (race.Jobs.Any(j => j.State == JobState.Running)) return JobState.Running;
        if (race.Jobs.Any(j => j.State == JobState.Queued)) return JobState.Queued;
        if (race.Jobs.Any(j => j.State == JobState.Failed)) return JobState.Failed;
        if (race.Jobs.All(j => j.State == JobState.Cancelled)) return JobState.Cancelled;
        return JobState.Succeeded;
    }

    private static bool RaceActive(RaceGroup race) => race.Jobs.Any(j => j.State is JobState.Queued or JobState.Running);
    private static bool RacePaused(RaceGroup race) => race.Jobs.Any(j => (j.State is JobState.Queued or JobState.Running) && j.Paused);
    private static string RaceError(RaceGroup race) => string.Join("; ", race.Jobs.Select(j => j.Error).Where(e => !string.IsNullOrWhiteSpace(e)).Distinct());
    private static string RacePathTitle(RaceGroup race) => string.Join(" | ", race.Jobs.Select(j => $"{j.Request.SourcePath} → {j.Request.DestPath}").Distinct());

    private string SectionNameFor(string site, string path)
    {
        var key = site + "|" + NormalizeSectionPath(path);
        return _sectionNames.TryGetValue(key, out var name) ? name : NormalizeSectionPath(path);
    }

    private static string ParentPath(string path)
    {
        path = (path ?? "").TrimEnd('/');
        if (path.Length == 0) return "/";
        var i = path.LastIndexOf('/');
        if (i <= 0) return "/";
        return path[..i];
    }

    private static string JoinRemote(string left, string right)
    {
        left = string.IsNullOrWhiteSpace(left) ? "/" : left.TrimEnd('/');
        right = (right ?? "").Trim('/');
        if (right.Length == 0) return left.Length == 0 ? "/" : left;
        return left == "/" ? "/" + right : left + "/" + right;
    }

    private void Pause(RaceGroup race) => RunForRace(race, j => (j.State is JobState.Queued or JobState.Running) && !j.Paused, Engine.PauseJob, "pause");
    private void Resume(RaceGroup race) => RunForRace(race, j => (j.State is JobState.Queued or JobState.Running) && j.Paused, Engine.ResumeJob, "resume");
    private void Stop(RaceGroup race) => RunForRace(race, j => j.State is JobState.Queued or JobState.Running, id => Engine.CancelJob(id, "Stopped by user"), "stop");
    private void Retry(RaceGroup race) => RunForRace(race, j => j.Terminal, Engine.RetryJob, "retry");
    private void Remove(RaceGroup race) => RunForRace(race, j => j.Terminal, Engine.RemoveJob, "remove");

    private void RunForRace(RaceGroup race, Func<Job, bool> select, Func<string, bool> action, string verb)
    {
        var failed = race.Jobs.Where(select).Count(j => !action(j.Id));
        if (failed > 0) Toast($"Could not {verb} {failed} race route(s)");
    }

    private void Toast(string message)
    {
        _toast = message;
        _ = HideToastLater();
    }

    private async Task HideToastLater()
    {
        await Task.Delay(2600);
        _toast = null;
        await InvokeAsync(StateHasChanged);
    }

    private static string StateClass(JobState s) => s switch
    {
        JobState.Succeeded => "green",
        JobState.Failed => "red",
        JobState.Running => "cyan",
        _ => "amber",
    };

    private static string HumanSize(long bytes)
    {
        if (bytes <= 0) return "0 B";
        string[] units = { "B", "KB", "MB", "GB", "TB" };
        double v = bytes;
        var u = 0;
        while (v >= 1024 && u < units.Length - 1) { v /= 1024; u++; }
        return u == 0 ? $"{bytes} B" : $"{v.ToString(v >= 100 ? "0" : "0.0")} {units[u]}";
    }

    private static string Speed(double bps)
    {
        if (bps <= 0) return "";
        string[] units = { "B/s", "KB/s", "MB/s", "GB/s" };
        var v = bps;
        var u = 0;
        while (v >= 1024 && u < units.Length - 1) { v /= 1024; u++; }
        return $"{v.ToString(v >= 100 ? "0" : "0.0")} {units[u]}";
    }

    private static string ProgressText(RaceGroup race)
    {
        var covered = RaceCoveredFiles(race);
        var total = RaceTotalFiles(race);
        var raced = RaceRacedFiles(race);
        var racedBytes = RaceRacedBytes(race);
        var count = total > 0 ? $"{covered}/{total} files covered" : $"{covered} files covered";
        var racedFiles = $" · {raced} {(raced == 1 ? "file" : "files")} raced";
        var totalBytes = race.Jobs.Max(j => j.BytesTotal);
        var bytes = totalBytes > 0
            ? $" · {HumanSize(racedBytes)} raced of {HumanSize(totalBytes)}"
            : racedBytes > 0 ? $" · {HumanSize(racedBytes)} raced" : "";
        var raceSpeed = race.Jobs.Sum(j => j.SpeedBps);
        var speed = raceSpeed > 0 ? $" · {Speed(raceSpeed)}" : "";
        return $"{count}{racedFiles}{bytes}{speed}";
    }

    private static int RacePercent(RaceGroup race)
    {
        if (RaceState(race) == JobState.Succeeded) return 100;
        var total = RaceTotalFiles(race);
        if (total > 0) return (int)Math.Clamp((long)RaceCoveredFiles(race) * 100 / total, 0, 100);
        return Math.Max(0, race.Jobs.Max(j => j.Percent));
    }

    private static bool HasRaceProgress(RaceGroup race) =>
        race.Jobs.Any(j => j.FilesTotal > 0 || j.BytesTotal > 0 || j.Files.Any(f => !IsMissingMarkerRow(f)));

    private static int RaceTotalFiles(RaceGroup race) => race.Jobs.Max(RaceTotalFiles);

    private static int RaceCoveredFiles(RaceGroup race)
    {
        var values = race.Jobs.Where(j => RaceTotalFiles(j) > 0).Select(RaceCoveredFiles).ToList();
        return values.Count == 0 ? 0 : values.Min();
    }

    private static int RaceRacedFiles(RaceGroup race) => race.Jobs.Sum(RaceRacedFiles);
    private static long RaceRacedBytes(RaceGroup race) => race.Jobs.Sum(RaceRacedBytes);

    private static int RaceTotalFiles(Job job) =>
        Math.Max(job.FilesTotal, job.Files
            .Where(f => !IsMissingMarkerRow(f))
            .Select(f => f.Name)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Count());

    private static int RaceCoveredFiles(Job job)
    {
        var coveredNames = job.Files
            .Where(f => !IsMissingMarkerRow(f) && f.Status is "done" or "dupe")
            .Select(f => f.Name)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Count();
        return Math.Max(job.FilesCovered, Math.Max(job.FilesDone, coveredNames));
    }

    private static int RaceRacedFiles(Job job) =>
        Math.Max(job.FilesDone, job.Files.Count(f => !IsMissingMarkerRow(f) && f.Status == "done"));

    private static long RaceRacedBytes(Job job) =>
        Math.Max(job.CumulativeBytes, job.Files
            .Where(f => !IsMissingMarkerRow(f) && f.Status == "done")
            .Sum(f => Math.Max(0, f.Size)));

    private static bool IsMissingMarkerRow(FileTransfer ft) =>
        ft.Name.EndsWith("-MISSING", StringComparison.OrdinalIgnoreCase);

    private static string RaceRuntime(RaceGroup race)
    {
        var start = race.Jobs.Min(j => j.StartedAt == default ? j.CreatedAt : j.StartedAt);
        if (start == default) return "—";
        var end = RaceActive(race)
            ? DateTime.UtcNow
            : race.Jobs.Max(j => j.FinishedAt == default ? j.CreatedAt : j.FinishedAt);
        var elapsed = end > start ? end - start : TimeSpan.Zero;
        if (elapsed.TotalHours >= 1) return $"{(int)elapsed.TotalHours}:{elapsed.Minutes:00}:{elapsed.Seconds:00}";
        if (elapsed.TotalMinutes >= 1) return $"{(int)elapsed.TotalMinutes}:{elapsed.Seconds:00}";
        return $"{elapsed.TotalSeconds:0.0}s";
    }
}
